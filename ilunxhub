local tracerLines = {}
local tracersLimpios = true
local tracerAccumulator = 0
local TRACER_INTERVAL = 1 / 30
local MAX_ESP_DISTANCE_SQ = MAX_ESP_DISTANCE * MAX_ESP_DISTANCE
local cachedViewportX, cachedViewportY = -1, -1
local centroVector = Vector2_new(0, 0)
local tracerOrigin = Vector2_new(0, 0)
local fovIdleColor = Color3_fromRGB(255, 255, 255)
local fovTargetColor = Color3_fromRGB(0, 255, 0)

local function hideTracersOnce()
    if tracersLimpios then return end
    for _, tLine in pairs(tracerLines) do
        if tLine.Visible then tLine.Visible = false end
    end
    tracersLimpios = true
end

-- Renderizado limitado a 30 FPS: visualmente fluido y con la mitad o menos
-- del trabajo que hacía el recorrido completo en cada frame.
runtime.Track(RunService.RenderStepped:Connect(function(deltaTime)
    tracerAccumulator = tracerAccumulator + deltaTime
    if tracerAccumulator < TRACER_INTERVAL then return end
    tracerAccumulator = 0

    local camera = workspace.CurrentCamera -- 🔥 FIX: Añadir esto aquí
    
    if not fovVisiblePreference and not espLinesEnabled then 
    -- ...
        if FOVCircle.Visible then FOVCircle.Visible = false end
        hideTracersOnce()
        return 
    end 

    local viewport = camera.ViewportSize
    if viewport.X ~= cachedViewportX or viewport.Y ~= cachedViewportY then
        cachedViewportX, cachedViewportY = viewport.X, viewport.Y
        centroVector = Vector2_new(viewport.X / 2, viewport.Y / 2)
        tracerOrigin = Vector2_new(centroVector.X, 0)
    end

    -- 1. Actualizar Círculo FOV
    if fovVisiblePreference then
        FOVCircle.Position = centroVector
        FOVCircle.Radius = fovRadius
        FOVCircle.Visible = true
        
        -- 🔥 FIX: Se pone verde incondicionalmente si hay un objetivo fijado (sin bugs de caché)
        if aimHookState.Target then
            FOVCircle.Color = Color3.fromRGB(0, 255, 0)
        else
            FOVCircle.Color = Color3.fromRGB(255, 255, 255)
        end
    else
        FOVCircle.Visible = false
    end

    -- 2. Líneas: usa el estado de lobby cacheado por el Heartbeat maestro.
    if not espEnabled or not espLinesEnabled or enLobby then
        hideTracersOnce()
        return
    end

    tracersLimpios = false

    local myChar = player.Character
    local myRoot = myChar and ffc(myChar, "HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or camera.CFrame.Position

    for i = 1, #listaJugadores do
        local p = listaJugadores[i]
        
        if p.ClassName == "Player" and p ~= player then
            local tLine = tracerLines[p]
            local char = p.Character
            local hrp = char and ffc(char, "HumanoidRootPart")
            local shouldShow = false
            
            if hrp and isEnemy(p) then
                local hum = ffc(char, "Humanoid")
                if hum and hum.Health > 0 then
                    local distanceDelta = myPos - hrp.Position
                    if distanceDelta:Dot(distanceDelta) <= MAX_ESP_DISTANCE_SQ then
                        local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            if not tLine then
                                tLine = runtime.TrackDrawing(Drawing.new("Line"))
                                tLine.Thickness = 1.5
                                tLine.Transparency = 1
                                tLine.Visible = false
                                tracerLines[p] = tLine
                            end

                            tLine.From = tracerOrigin
                            tLine.To = Vector2_new(hrpPos.X, hrpPos.Y)
                            
                            if tLine.Color ~= espColor then tLine.Color = espColor end
                            if not tLine.Visible then tLine.Visible = true end
                            shouldShow = true
                        end
                    end
                end
            end
            
            if not shouldShow and tLine and tLine.Visible then tLine.Visible = false end
        end
    end
end))

