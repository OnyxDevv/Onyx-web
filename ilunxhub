-- TOGGLE
-- ==========================================

Tabs.KillAll:Toggle({

    Title = "Activar Kill All",

    Desc =
        "Single Hit · espera protección · TP único",

    Value = false,


    Callback = function(Value)

        killAllEnabled =
            Value


        -- ==================================
        -- ACTIVAR
        -- ==================================

        if Value then

            local char =
                player.Character

            local hrp =
                char
                and char:FindFirstChild(
                    "HumanoidRootPart"
                )


            if hrp then

                -- Guardar exactamente donde
                -- activamos el Kill All.
                killAllBaseCFrame =
                    hrp.CFrame

            else

                killAllBaseCFrame =
                    nil
            end


            table.clear(
                failedTargets
            )


            showBottomMessage(
                "Kill All: ACTIVADO (Single Hit)"
            )


            task.spawn(function()

                while runtime.Alive
                    and killAllEnabled
                do

                    -- =========================
                    -- PERSONAJE LOCAL
                    -- =========================

                    local myChar =
                        player.Character

                    local myHum =
                        myChar
                        and myChar:
                            FindFirstChildOfClass(
                                "Humanoid"
                            )

                    local myHrp =
                        myChar
                        and myChar:
                            FindFirstChild(
                                "HumanoidRootPart"
                            )

                    local backpack =
                        player:
                            FindFirstChild(
                                "Backpack"
                            )


                    if not myChar
                        or not myHum
                        or not myHrp
                        or not backpack
                        or myHum.Health <= 0
                    then

                        task.wait(0.20)
                        continue
                    end


                    if not killAllBaseCFrame then
                        killAllBaseCFrame =
                            myHrp.CFrame
                    end


                    -- =========================
                    -- NO ATACAR EN LOBBY
                    -- =========================

                    if estaEnLobby() then

                        task.wait(0.20)
                        continue
                    end


                    -- =========================
                    -- BUSCAR ENEMIGOS
                    -- =========================

                    local encontroObjetivo =
                        false


                    for _, targetPlayer
                        in ipairs(
                            Players:GetPlayers()
                        )
                    do

                        if not runtime.Alive
                            or not killAllEnabled
                        then
                            break
                        end


                        if targetPlayer ~= player
                            and isEnemy(
                                targetPlayer
                            )
                            and targetPlayer.Character
                        then

                            local enemyHum =
                                targetPlayer.Character:
                                    FindFirstChildOfClass(
                                        "Humanoid"
                                    )

                            local enemyHrp =
                                targetPlayer.Character:
                                    FindFirstChild(
                                        "HumanoidRootPart"
                                    )


                            if enemyHum
                                and enemyHrp
                                and enemyHum.Health > 0
                            then

                                local distancia =
                                    (
                                        killAllBaseCFrame.Position
                                        - enemyHrp.Position
                                    ).Magnitude


                                if distancia <=
                                    KILL_RANGE
                                then

                                    encontroObjetivo =
                                        true


                                    -- =================
                                    -- UN SOLO INTENTO
                                    -- =================

                                    atacarUnaVezKillAll(
                                        targetPlayer,
                                        myChar,
                                        myHum,
                                        myHrp
                                    )


                                    -- Pase lo que pase,
                                    -- siguiente enemigo
                                    -- empieza desde base.
                                    regresarBaseKillAll(
                                        myHrp
                                    )


                                    task.wait(0.025)
                                end
                            end
                        end
                    end


                    -- =========================
                    -- FIN DEL BARRIDO
                    -- =========================

                    regresarBaseKillAll(
                        myHrp
                    )


                    pcall(function()

                        local currentTool =
                            myChar:
                                FindFirstChildOfClass(
                                    "Tool"
                                )

                        if currentTool then
                            currentTool:
                                Deactivate()
                        end

                    end)


                    if encontroObjetivo then
                        task.wait(0.08)
                    else
                        task.wait(0.18)
                    end
                end
            end)


        -- ==================================
        -- DESACTIVAR
        -- ==================================

        else

            showBottomMessage(
                "Kill All: DESACTIVADO"
            )


            pcall(function()

                local char =
                    player.Character

                local hrp =
                    char
                    and char:
                        FindFirstChild(
                            "HumanoidRootPart"
                        )


                if hrp then

                    freezeKillRoot(
                        hrp
                    )


                    -- Al apagar, mantener ubicación
                    -- actual y volver a pararse.
                    local _, rotY, _ =
                        hrp.CFrame:
                            ToEulerAnglesXYZ()


                    hrp.CFrame =
                        CFrame.new(
                            hrp.Position
                        )
                        * CFrame.Angles(
                            0,
                            rotY,
                            0
                        )
                end
            end)


            killAllBaseCFrame =
                nil

            table.clear(
                failedTargets
            )
        end
    end
})

-- ====================
