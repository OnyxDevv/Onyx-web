        end

        if state then
            -- 1. APAGAR ILUMINACIÓN GLOBAL
            origGlobalShadows = Lighting.GlobalShadows
            origFogEnd = Lighting.FogEnd
            origShadowSoftness = Lighting.ShadowSoftness
            
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
