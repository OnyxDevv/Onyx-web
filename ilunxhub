Tabs.KillAll:Section({
    Title = "Kill all OP (Single Hit)"
})

local killAllEnabled = false
local killAllBaseCFrame = nil

local KILL_RANGE = 600

-- Tiempo que el enemigo debe permanecer
-- sin protección antes de atacarlo.
local VULNERABLE_STABLE_TIME = 0.25

-- Cuánto esperar máximo a que se quite
-- la protección de ronda.
local VULNERABLE_TIMEOUT = 12

-- Offset estando acostado debajo del enemigo.
local ATTACK_OFFSET = CFrame.new(0, -2.75, 0)

-- Tiempo para comprobar si el golpe registró.
local HIT_CONFIRM_TIME = 0.40

-- Si un golpe no registra, no insistimos
-- inmediatamente contra ese mismo jugador.
local FAILED_RETRY_DELAY = 0.30

local failedTargets = {}


-- ==========================================
-- FREEZE ROOT
-- ==========================================

local function freezeKillRoot(hrp)
    if not hrp or not hrp.Parent then
        return
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end


-- ==========================================
-- VULNERABILIDAD
-- ==========================================

local function estaRealmenteVulnerableKillAll(char)
    if not char or not char.Parent then
        return false
    end

    local hum =
        char:FindFirstChildOfClass("Humanoid")

    local hrp =
        char:FindFirstChild("HumanoidRootPart")

    if not hum or not hrp then
        return false
    end

    if hum.Health <= 0 then
        return false
    end

    -- Protección clásica
    if char:FindFirstChildOfClass("ForceField") then
        return false
    end

    -- Durante ciertos estados de ronda
    if hrp.Anchored then
        return false
    end

    if hum.WalkSpeed <= 0 then
        return false
    end

    -- Otros estados obvios donde todavía
    -- no queremos intentar pegar.
    local state = hum:GetState()

    if state == Enum.HumanoidStateType.Dead then
        return false
    end

    return true
end


-- ==========================================
-- ESPERAR A QUE DE VERDAD ESTÉ LISTO
-- ==========================================

local function esperarVulnerabilidadKillAll(char)
    local startedAt = os.clock()
    local stableSince = nil

    while runtime.Alive
        and killAllEnabled
        and char
        and char.Parent
    do
        local hum =
            char:FindFirstChildOfClass("Humanoid")

        if not hum or hum.Health <= 0 then
            return false
        end

        if estaRealmenteVulnerableKillAll(char) then

            if not stableSince then
                stableSince = os.clock()
            end

            if (
                os.clock()
                - stableSince
            ) >= VULNERABLE_STABLE_TIME
            then
                return true
            end

        else
            -- Si reaparece cualquier protección,
            -- reiniciamos el contador.
            stableSince = nil
        end

        if (
            os.clock()
            - startedAt
        ) >= VULNERABLE_TIMEOUT
        then
            return false
        end

        task.wait(0.03)
    end

    return false
end


-- ==========================================
-- DETECTOR DE CUCHILLO
-- ==========================================

local KNIFE_WORDS = {
    "knife",
    "cuchillo",
    "blade",
    "dagger",
    "kunai"
}

local function esCuchilloKillAll(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    -- La estructura interna tiene prioridad
    -- sobre el nombre.
    if tool:FindFirstChild("KnifeClient", true)
        or tool:FindFirstChild("KnifeServer", true)
        or tool:FindFirstChild("Throw", true)
        or tool:FindFirstChild("Kill", true)
    then
        return true
    end

    local name =
        string.lower(tool.Name)

    for i = 1, #KNIFE_WORDS do
        if string.find(
            name,
            KNIFE_WORDS[i],
            1,
            true
        ) then
            return true
        end
    end

    return false
end


-- ==========================================
-- EQUIPAR CUCHILLO
-- ==========================================

local function obtenerCuchilloKillAll(char, hum)
    if not char or not hum then
        return nil
    end

    -- Ya equipado
    for _, tool in ipairs(char:GetChildren()) do
        if esCuchilloKillAll(tool) then
            return tool
        end
    end

    local backpack =
        player:FindFirstChild("Backpack")

    if not backpack then
        return nil
    end

    -- Quitar cualquier otra herramienta
    local equipped =
        char:FindFirstChildOfClass("Tool")

    if equipped
        and not esCuchilloKillAll(equipped)
    then
        pcall(function()
            hum:UnequipTools()
        end)

        RunService.Heartbeat:Wait()
    end

    -- Buscar cuchillo
    for _, tool in ipairs(backpack:GetChildren()) do
        if esCuchilloKillAll(tool) then

            pcall(function()
                hum:EquipTool(tool)
            end)

            local equipDeadline =
                os.clock() + 0.40

            while runtime.Alive
                and killAllEnabled
                and tool.Parent ~= char
                and os.clock() < equipDeadline
            do
                RunService.Heartbeat:Wait()
            end

            if tool.Parent == char then
                return tool
            end
        end
    end

    return nil
end


-- ==========================================
-- REGRESAR A BASE
-- ==========================================

local function regresarBaseKillAll(hrp)
    if not hrp
        or not hrp.Parent
        or not killAllBaseCFrame
    then
        return
    end

    hrp.CFrame =
        killAllBaseCFrame
        * CFrame.Angles(
            math.rad(90),
            0,
            0
        )

    freezeKillRoot(hrp)
end


-- ==========================================
-- UN SOLO ATAQUE
-- ==========================================

local function atacarUnaVezKillAll(
    targetPlayer,
    myChar,
    myHum,
    myHrp
)
    if not targetPlayer
        or targetPlayer == player
        or not targetPlayer.Character
    then
        return false
    end

    local enemyChar =
        targetPlayer.Character

    local enemyHum =
        enemyChar:FindFirstChildOfClass("Humanoid")

    local enemyHrp =
        enemyChar:FindFirstChild("HumanoidRootPart")

    if not enemyHum
        or not enemyHrp
        or enemyHum.Health <= 0
    then
        return false
    end


    -- ======================================
    -- EVITAR REINTENTOS ABSURDAMENTE RÁPIDOS
    -- ======================================

    local retryAt =
        failedTargets[targetPlayer]

    if retryAt
        and os.clock() < retryAt
    then
        return false
    end


    -- ======================================
    -- RANGO DESDE LA POSICIÓN ORIGINAL
    -- ======================================

    local baseCF =
        killAllBaseCFrame
        or myHrp.CFrame

    if (
        baseCF.Position
        - enemyHrp.Position
    ).Magnitude > KILL_RANGE
    then
        return false
    end


    -- ======================================
    -- ESPERAR PROTECCIÓN
    --
    -- NO hacemos TP hasta que haya estado
    -- vulnerable durante un rato estable.
    -- ======================================

    local vulnerable =
        esperarVulnerabilidadKillAll(
            enemyChar
        )

    if not vulnerable then
        return false
    end


    -- Volvemos a comprobar porque pudo cambiar
    -- mientras esperábamos.
    enemyHum =
        enemyChar:FindFirstChildOfClass(
            "Humanoid"
        )

    enemyHrp =
        enemyChar:FindFirstChild(
            "HumanoidRootPart"
        )

    if not enemyHum
        or not enemyHrp
        or enemyHum.Health <= 0
        or not estaRealmenteVulnerableKillAll(
            enemyChar
        )
    then
        return false
    end


    -- ======================================
    -- EQUIPAR CUCHILLO ANTES DEL TP
    -- ======================================

    local arma =
        obtenerCuchilloKillAll(
            myChar,
            myHum
        )

    if not arma then
        return false
    end


    -- ======================================
    -- VIDA ANTES DEL GOLPE
    -- ======================================

    local vidaAntes =
        enemyHum.Health


    -- ======================================
    -- TP UNA SOLA VEZ
    -- ======================================

    myHrp.CFrame =
        enemyHrp.CFrame
        * ATTACK_OFFSET
        * CFrame.Angles(
            math.rad(90),
            0,
            0
        )

    freezeKillRoot(myHrp)


    -- ======================================
    -- IMPORTANTE:
    -- ESPERAMOS DOS HEARTBEATS REALES.
    --
    -- El personaje YA está con el enemigo
    -- antes de ejecutar el cuchillazo.
    -- ======================================

    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()


    -- Si durante esos frames volvió la protección,
    -- abortamos sin pegar.
    if not killAllEnabled
        or not enemyChar.Parent
        or not enemyHum.Parent
        or enemyHum.Health <= 0
        or not estaRealmenteVulnerableKillAll(
            enemyChar
        )
    then

        regresarBaseKillAll(
            myHrp
        )

        return false
    end


    -- ======================================
    -- UN SOLO CUCHILLAZO
    -- ======================================

    pcall(function()
        arma:Activate()
    end)


    -- Dejamos que el Tool complete su pulsación.
    task.wait(0.035)


    pcall(function()
        if arma
            and arma.Parent == myChar
        then
            arma:Deactivate()
        end
    end)


    -- ======================================
    -- CONFIRMACIÓN
    --
    -- Ya NO hacemos spam.
    -- Nos quedamos ahí esperando resultado.
    -- ======================================

    local confirmStart =
        os.clock()

    local pego = false


    while runtime.Alive
        and killAllEnabled
        and enemyHum
        and enemyHum.Parent
        and (
            os.clock()
            - confirmStart
        ) < HIT_CONFIRM_TIME
    do

        if enemyHum.Health <= 0 then
            pego = true
            break
        end

        if enemyHum.Health < vidaAntes then
            pego = true
            break
        end

        RunService.Heartbeat:Wait()
    end


    -- ======================================
    -- BASE
    -- ======================================

    regresarBaseKillAll(
        myHrp
    )


    -- Si no registró, no spamearlo:
    -- dejamos una pequeña pausa y se probará
    -- en el siguiente barrido.
    if not pego then

        failedTargets[targetPlayer] =
            os.clock()
            + FAILED_RETRY_DELAY

    else

        failedTargets[targetPlayer] =
            nil
    end


    return pego
end


