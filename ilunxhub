function ToggleGhostSeatMode(state)
    isInvisible = state
    local char = player.Character
    if not char then return end

    if isInvisible then
        realChar = char
        local hrp = realChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        -- 1. CLONAMOS TU PERSONAJE (Este será tu fantasma local)
        realChar.Archivable = true
        fakeChar = realChar:Clone()
        fakeChar.Name = "Fantasma_AlexDev"
        fakeChar.Parent = workspace
        
        -- Volvemos el clon invisible SOLO para ti
        for _, v in pairs(fakeChar:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("ParticleEmitter") or v:IsA("BillboardGui") then
                v.Enabled = false
            end
        end
        
        -- 2. ESCONDEMOS TU CUERPO REAL (300 studs arriba, nadie lo verá)
        local hidePos = hrp.Position + Vector3.new(0, 300, 0)
        
        fakePlatform = Instance.new("Part")
        fakePlatform.Name = "AstraGhostPlatform"
        fakePlatform.Size = Vector3.new(10, 2, 10)
        fakePlatform.CFrame = CFrame.new(hidePos - Vector3.new(0, 3, 0))
        fakePlatform.Anchored = true
        fakePlatform.Transparency = 1
        fakePlatform.Parent = workspace
        
        -- Movemos el cuerpo real y lo congelamos
        hrp.CFrame = CFrame.new(hidePos)
        for _, v in ipairs(realChar:GetChildren()) do
            if v:IsA("BasePart") then v.Anchored = true end
        end
        
        -- 3. TE DAMOS EL CONTROL DEL FANTASMA
        workspace.CurrentCamera.CameraSubject = fakeChar:FindFirstChild("Humanoid")
        
        local fakeHrp = fakeChar:FindFirstChild("HumanoidRootPart")
        if fakeHrp then
            invisBg = Instance.new("BodyGyro")
            invisBg.P = 9e4
            invisBg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            invisBg.cframe = fakeHrp.CFrame
            invisBg.Parent = fakeHrp
            
            invisBv = Instance.new("BodyVelocity")
            invisBv.velocity = Vector3.zero
            invisBv.maxForce = Vector3.new(9e9, 9e9, 9e9)
            invisBv.Parent = fakeHrp
            
            fakeChar:FindFirstChild("Humanoid").PlatformStand = true
        end
        
    else
        -- APAGAR MODO FANTASMA
        if fakeChar then
            local fakeHrp = fakeChar:FindFirstChild("HumanoidRootPart")
            local realHrp = realChar and realChar:FindFirstChild("HumanoidRootPart")
            
            if fakeHrp and realHrp then
                -- Descongelamos tu cuerpo real
                for _, v in ipairs(realChar:GetChildren()) do
                    if v:IsA("BasePart") then v.Anchored = false end
                end
                -- Lo traemos mágicamente a donde viajaste con el fantasma
                realHrp.CFrame = fakeHrp.CFrame
            end
            
            fakeChar:Destroy()
            fakeChar = nil
        end
        
        if fakePlatform then
            fakePlatform:Destroy()
            fakePlatform = nil
        end
        
        if invisBg then invisBg:Destroy(); invisBg = nil end
        if invisBv then invisBv:Destroy(); invisBv = nil end
        
        if realChar then
            workspace.CurrentCamera.CameraSubject = realChar:FindFirstChild("Humanoid")
        end
