    local function requestActiveUsers()
        if not req then
            return nil
        end

        local success, response = pcall(function()
            return req({
                Url = "https://hub.onyx-scripts.com/ping?user="
                    .. tostring(player.Name)
                    .. "&jobid="
                    .. tostring(game.JobId),
                Method = "GET",
                Headers = {
                    ["Astra-Auth"] = "OnyxHub!",
                    ["User-Agent"] = "Roblox/iLunXHub"
                }
            })
        end)

        if not success or not response then
            return nil
        end

        -- Compatibilidad con distintos formatos de request().
        local statusCode =
            tonumber(response.StatusCode)
            or tonumber(response.Status)
            or (response.Success == true and 200 or nil)

        if statusCode and statusCode ~= 200 then
            return nil
        end

        local body = response.Body
        if body == nil then body = response.body end
        if body == nil then return nil end

        local cleaned = tostring(body):match("^%s*(.-)%s*$")
        local direct = tonumber(cleaned)
        if direct then return direct end

        -- Fallback por si el backend alguna vez devuelve JSON.
        local okJson, decoded = pcall(function()
            return HttpService:JSONDecode(cleaned)
        end)

        if okJson and type(decoded) == "table" then
            return tonumber(
                decoded.active
                or decoded.activos
                or decoded.users
                or decoded.count
            )
        end

        return nil
    end

