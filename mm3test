    while not Runtime.Destroyed do
        local vivos = requestActiveUsers()

        if vivos then
            applyActiveCount(vivos)
        elseif Runtime.ActiveUsers then
            -- Si sólo falló el lookup del label, volvemos a intentar mostrar
            -- el último valor sin requerir otro ping exitoso.
            applyActiveCount(Runtime.ActiveUsers)
        end

        task.wait(10)
    end
end)

