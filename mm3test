local function stopFling()
    currentFlingTarget = nil 
    if flingLoop then flingLoop:Disconnect(); flingLoop = nil end 
    if bV then bV:Destroy(); bV = nil end 
    if bAv then bAv:Destroy(); bAv = nil end
    
