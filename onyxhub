local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
while not player do task.wait() player = Players.LocalPlayer end

local miNombre = player.Name

-- 🔥 FIX: Convertimos el PlaceId a texto desde el inicio
local pid = tostring(game.PlaceId)
local gameType = pid 

-- 🔥 FIX: Comparamos puro texto (con comillas) para que no falle en Delta u otros inyectores
if pid == "142823291" or pid == "107790569538621" or pid == "93017634738276" or pid == "70670854739587" or pid == "74369636333825" then
    gameType = "MM2"
elseif pid == "116817810725116" or pid == "119068914321553" or pid == "134963371142373" or pid == "86635050681926" or pid == "129043781833299" or pid == "101617670515690" or pid == "120700541929930" or pid == "123627218337521" or pid == "131117978948830" or pid == "92876937625630" or pid == "74084441161738" or pid == "124848751642883" or pid == "135856908115931" or pid == "114176825419426" then
    gameType = "DUELS"
end

local req = (syn and syn.request) or (http and http.request) or http_request or request
if req then
    local response = req({
        Url = "https://hub.onyx-scripts.com/api/v2/get_hub",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "Roblox/AstraHub"
        },
        Body = HttpService:JSONEncode({
            auth = "OnyxHub!",
            hwid = "Omitido", 
            user = miNombre,
            game = gameType,
            placeId = pid
        })
    })

    if response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data.success then
            local func, err = loadstring(data.code)
            if func then func() else warn("Error al cargar:", err) end
        end
    else
        player:Kick("\nOnyx Security\nAcceso Denegado o IP Baneada.")
    end
else
    player:Kick("Tu Inyector no soporta peticiones HTTP seguras.")
end
