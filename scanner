track(RunService.Heartbeat:Connect(function()
    if not RT.Alive then return end

    local now = os.clock()
    local current = equippedTool()

    if current ~= RT.Tool or now - RT.LastScan >= 1.0 then
        RT.LastScan = now
        if current ~= RT.Tool or not RT.BeamFunction then
            fullRescan()
        end
    end

    RT.TargetPlayer, RT.TargetPart = getTarget()

    local toolText = RT.Tool and RT.Tool.Name or "ninguna"
    local targetText = RT.TargetPlayer and RT.TargetPlayer.Name or "ninguno"

    status.Text =
        "Tool: " .. toolText ..
        "\nBeam: " .. (RT.BeamFunction and "ENCONTRADA" or "NO ENCONTRADA") ..
        "\nEstrategia: " .. tostring(RT.Strategy) ..
        "\nTarget: " .. targetText ..
        "\n\n" .. tostring(RT.Detail)
end))

local function fireBeam()
    if not RT.BeamFunction then
        fullRescan()
    end

    local tool = RT.Tool
    local beam = RT.BeamFunction
    local target = RT.TargetPart
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not tool or not isGunTool(tool) then
        RT.Detail = "ERROR: equipa la pistola."
        return
    end
    if not beam then
        RT.Detail = "ERROR: Beam sigue sin encontrarse.\n" .. tostring(RT.Detail)
        return
    end
    if not target or not target.Parent then
        RT.Detail = "ERROR: no hay target visible."
        return
    end
    if not hrp then
        RT.Detail = "ERROR: no hay HRP."
        return
    end

    local now = os.clock()
    if now - RT.LastShot < 2.55 then
        RT.Detail = "Cooldown: espera ~2.5 s."
        return
    end
    RT.LastShot = now

    local ok, err = pcall(beam, target.Position, hrp.Position, tool)
    if ok then
        RT.Detail =
            "LLAMADA OK a Beam real.\n" ..
            "Target=" .. tostring(RT.TargetPlayer and RT.TargetPlayer.Name or "?") ..
            "\nRevisa Gunshot / beam / daño."
    else
        RT.Detail = "ERROR llamando Beam:\n" .. tostring(err)
        warn("[Xero Bimo Beam v2] " .. tostring(err))
    end
end

