function RT.Cleanup()
    if not RT.Alive then return end
    RT.Alive=false
    RT.Capturing=false

    for i=#RT.Connections,1,-1 do
        pcall(function() RT.Connections[i]:Disconnect() end)
        RT.Connections[i]=nil
    end

    if RT.HookInstalled and RT.ShootFn and RT.OldShoot and type(hookfunction)=="function" then
        pcall(hookfunction,RT.ShootFn,RT.OldShoot)
    end

    if gui and gui.Parent then
        pcall(function() gui:Destroy() end)
    end

    if ENV.__XERO_BIMO_SHOOT_SAFE_V4==RT then
        ENV.__XERO_BIMO_SHOOT_SAFE_V4=nil
    end
end

