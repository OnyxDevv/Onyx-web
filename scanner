--[[
    XeroHub - Kill All PoC v6
    Creator: Kev

    Cambios clave:
    - Corrige resolución del remote de throw:
        el scanner muestra nombres tipo "RE/<hash>" dentro de Net,
        no necesariamente una carpeta "RE".
    - Intenta PRIMERO la activación nativa de Tool.Activated.
    - Si la activación nativa no crea ningún cuchillo,
      usa fallback manual con el remote de THROW + LocalThrowingKnife.
    - Registra en consola si aparecen:
        LocalThrowingKnife
        ThrowingLocalKnife
        ThrowingServerKnife
        ThrowingKnifeServer
    - NO dispara directamente el remote final de daño.

    Es un PoC separado.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ============================================================
-- CONFIG
-- ============================================================

local PLATFORM_SIZE = Vector3.new(10, 1, 10)

local APPROACH_DISTANCE = 14
local APPROACH_TOLERANCE = 2.5

local RETARGET_RATE = 0.08
local PLATFORM_RATE = 1 / 30

local HITBOX_SIZE = Vector3.new(30, 30, 30)
local HITBOX_TRANSPARENCY = 0.45

local MAX_NATIVE_ATTEMPTS = 3
local MAX_MANUAL_THROWS = 12
local THROW_DELAY = 0.045

local THROW_HASH =
    "2b789bb88cbd439d2c8a04ef507c52a5d3cad6c302d7755858ffb1afab45d869"

local THROW_TOKEN =
    "959d5e90-231d-4f6e-8861-050e2c22b938"

-- ============================================================
-- STATE
-- ============================================================

local running = true
local platform
local hitbox
local platformConn

local mapBackup = {}
local savedAutoRotate

-- ============================================================
-- CHARACTER HELPERS
-- ============================================================

local function getCharacter(player)
    local char = player and player.Character
    if not char then
        return nil
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 then
        return nil
    end

    return char, hum, root
end

local function isEnemy(player)
    if not player or player == LP then
        return false
    end

    local char, hum = getCharacter(player)
    if not char or not hum then
        return false
    end

    if LP.Team ~= nil
        and player.Team ~= nil
        and LP.Team == player.Team
    then
        return false
    end

    return true
end

local function nearestEnemy()
    local _, _, root = getCharacter(LP)
    if not root then
        return nil
    end

    local best
    local bestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local _, _, targetRoot = getCharacter(player)

            if targetRoot then
                local d = (targetRoot.Position - root.Position).Magnitude

                if d < bestDist then
                    bestDist = d
                    best = player
                end
            end
        end
    end

    return best, bestDist
end

local function supportOffset(hum, root)
    return hum.HipHeight
        + (root.Size.Y * 0.5)
        + (PLATFORM_SIZE.Y * 0.5)
end

-- ============================================================
-- MAP NOCLIP
-- ============================================================

local function disableMapCollision()
    local activeMaps = workspace:FindFirstChild("ActiveMaps")

    if not activeMaps then
        warn("[XERO v6] workspace.ActiveMaps no existe")
        return
    end

    local count = 0

    for _, obj in ipairs(activeMaps:GetDescendants()) do
        if obj:IsA("BasePart") then
            mapBackup[obj] = {
                CanCollide = obj.CanCollide,
                CanQuery = obj.CanQuery
            }

            obj.CanQuery = true
            obj.CanCollide = false
            count += 1
        end
    end

    print(("[XERO v6] noclip -> %d partes"):format(count))
end

local function restoreMapCollision()
    for obj, props in pairs(mapBackup) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = props.CanCollide
                obj.CanQuery = props.CanQuery
            end)
        end
    end

    table.clear(mapBackup)
end

-- ============================================================
-- PORTABLE FLOOR
-- ============================================================

local function createPlatform()
    local _, hum, root = getCharacter(LP)
    if not hum or not root then
        return nil
    end

    local offset = supportOffset(hum, root)

    local p = Instance.new("Part")
    p.Name = "p" .. tostring(math.random(100000, 999999))
    p.Size = PLATFORM_SIZE
    p.Anchored = true
    p.CanCollide = true
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.CastShadow = false

    p.CFrame = CFrame.new(
        root.Position.X,
        root.Position.Y - offset,
        root.Position.Z
    )

    p.Parent = Camera

    platform = p
    return p
end

local function startPlatformFollow()
    local acc = 0

    platformConn = RunService.Heartbeat:Connect(function(dt)
        if not running or not platform or not platform.Parent then
            return
        end

        acc += dt
        if acc < PLATFORM_RATE then
            return
        end

        acc = 0

        local _, hum, root = getCharacter(LP)
        if not hum or not root then
            return
        end

        local offset = supportOffset(hum, root)

        platform.CFrame = CFrame.new(
            root.Position.X,
            root.Position.Y - offset,
            root.Position.Z
        )
    end)
end

-- ============================================================
-- KNIFE
-- ============================================================

local function findKnife()
    local char = LP.Character
    local backpack = LP:FindFirstChildOfClass("Backpack")

    local knife = char and char:FindFirstChild("DefaultKnife")

    if not knife and backpack then
        knife = backpack:FindFirstChild("DefaultKnife")
    end

    return knife
end

local function equipKnife()
    local char, hum = getCharacter(LP)

    if not char or not hum then
        return nil, "character inválido"
    end

    local knife = findKnife()

    if not knife then
        return nil, "DefaultKnife no encontrado"
    end

    if knife.Parent ~= char then
        hum:EquipTool(knife)

        local deadline = os.clock() + 2

        repeat
            RunService.Heartbeat:Wait()
        until knife.Parent == char or os.clock() >= deadline
    end

    if knife.Parent ~= char then
        return nil, "DefaultKnife no se equipó"
    end

    print("[XERO v6] DefaultKnife equipado")

    return knife
end

-- ============================================================
-- TARGET HITBOX
-- ============================================================

local function createTargetHitbox(target)
    local char, _, root = getCharacter(target)

    if not char or not root then
        return nil
    end

    local old = char:FindFirstChild("HitboxPart")
    if old then
        pcall(function()
            old:Destroy()
        end)
    end

    local p = Instance.new("Part")
    p.Name = "HitboxPart"
    p.Shape = Enum.PartType.Block
    p.Size = HITBOX_SIZE
    p.CFrame = root.CFrame
    p.Anchored = false
    p.CanCollide = false
    p.CanQuery = true
    p.CanTouch = false
    p.Massless = true
    p.Transparency = HITBOX_TRANSPARENCY
    p.Color = Color3.new(1, 0, 0)
    p.CastShadow = false

    local weld = Instance.new("WeldConstraint")
    weld.Name = "WeldConstraint"
    weld.Part0 = p
    weld.Part1 = root
    weld.Parent = p

    p.Parent = char

    hitbox = p

    print("[XERO v6] HitboxPart 30x30x30 creado")

    return p
end

-- ============================================================
-- APPROACH
-- ============================================================

local function approachTarget(target)
    while running do
        local _, hum, root = getCharacter(LP)
        local _, targetHum, targetRoot = getCharacter(target)

        if not hum or not root or not targetHum or not targetRoot then
            return false
        end

        local flatDelta = Vector3.new(
            targetRoot.Position.X - root.Position.X,
            0,
            targetRoot.Position.Z - root.Position.Z
        )

        local distance = flatDelta.Magnitude

        if distance <= APPROACH_DISTANCE + APPROACH_TOLERANCE then
            pcall(function()
                hum:MoveTo(root.Position)
                hum:Move(Vector3.zero, false)
            end)

            savedAutoRotate = hum.AutoRotate
            hum.AutoRotate = false
            root.AssemblyAngularVelocity = Vector3.zero

            print(("[XERO v6] en rango -> %.2f studs"):format(distance))

            return true
        end

        local dir =
            flatDelta.Magnitude > 0.001
            and flatDelta.Unit
            or Vector3.new(0, 0, -1)

        local standPos =
            targetRoot.Position
            - (dir * APPROACH_DISTANCE)

        standPos = Vector3.new(
            standPos.X,
            root.Position.Y,
            standPos.Z
        )

        hum:MoveTo(standPos)

        task.wait(RETARGET_RATE)
    end

    return false
end

-- ============================================================
-- THROW OBJECT WATCH
-- ============================================================

local watchedNames = {
    LocalThrowingKnife = true,
    ThrowingLocalKnife = true,
    ThrowingServerKnife = true,
    ThrowingKnifeServer = true,
}

local function isThrowName(name)
    if watchedNames[name] then
        return true
    end

    local lower = string.lower(name)

    return string.find(lower, "throwing")
        and string.find(lower, "knife")
end

local function startThrowWatch()
    local seen = 0
    local cons = {}

    local function hook(parent, label)
        table.insert(cons, parent.ChildAdded:Connect(function(obj)
            if isThrowName(obj.Name) then
                seen += 1
                print(("[XERO v6] APARECIÓ %s -> %s"):format(
                    label,
                    obj.Name
                ))
            end
        end))
    end

    hook(workspace, "Workspace")

    local rendered = workspace:FindFirstChild("RenderedObjects")
    if rendered then
        hook(rendered, "RenderedObjects")
    end

    return function()
        for _, con in ipairs(cons) do
            con:Disconnect()
        end

        return seen
    end
end

-- ============================================================
-- NATIVE ACTIVATED
-- ============================================================

local function nativeActivate(knife)
    print("[XERO v6] intentando Activated nativo...")

    local used = 0

    if type(getconnections) == "function" then
        local ok, connections = pcall(getconnections, knife.Activated)

        if ok and type(connections) == "table" then
            print(("[XERO v6] getconnections -> %d conexiones"):format(
                #connections
            ))

            for index, con in ipairs(connections) do
                local fired = false

                -- Primero el método Fire de la conexión, que es lo más
                -- parecido a lo observado.
                local okFire = pcall(function()
                    if con.Fire then
                        con:Fire()
                        fired = true
                    end
                end)

                if fired and okFire then
                    used += 1
                    print(("[XERO v6] connection %d -> Fire() OK"):format(index))
                else
                    local fn

                    pcall(function()
                        fn = con.Function
                    end)

                    if type(fn) == "function" then
                        local okFn = pcall(fn)

                        if okFn then
                            used += 1
                            print(("[XERO v6] connection %d -> Function() OK"):format(index))
                        end
                    end
                end
            end
        else
            warn("[XERO v6] getconnections falló")
        end
    else
        warn("[XERO v6] executor sin getconnections")
    end

    if used == 0 then
        if type(firesignal) == "function" then
            local ok = pcall(firesignal, knife.Activated)

            if ok then
                used += 1
                print("[XERO v6] firesignal(Activated) OK")
            end
        end
    end

    if used == 0 then
        local ok = pcall(function()
            knife:Activate()
        end)

        if ok then
            used += 1
            print("[XERO v6] Tool:Activate() fallback")
        end
    end

    return used > 0
end

-- ============================================================
-- THROW REMOTE RESOLUTION
-- ============================================================

local function resolveThrowRemote()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    local net = packages and packages:FindFirstChild("Net")

    if not net then
        return nil
    end

    -- FORMA 1:
    -- Lo más probable según el log:
    -- Instance.Name == "RE/<hash>"
    local direct =
        net:FindFirstChild("RE/" .. THROW_HASH)

    if direct and direct:IsA("RemoteEvent") then
        print("[XERO v6] remote throw encontrado como Net['RE/<hash>']")
        return direct
    end

    -- FORMA 2:
    -- por si RE sí fuera Folder.
    local reFolder = net:FindFirstChild("RE")

    if reFolder then
        local nested = reFolder:FindFirstChild(THROW_HASH)

        if nested and nested:IsA("RemoteEvent") then
            print("[XERO v6] remote throw encontrado como Net.RE.<hash>")
            return nested
        end
    end

    -- FORMA 3:
    -- scan recursivo por nombre exacto o suffix.
    for _, obj in ipairs(net:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            if obj.Name == THROW_HASH
                or obj.Name == ("RE/" .. THROW_HASH)
                or string.find(obj.Name, THROW_HASH, 1, true)
            then
                print(("[XERO v6] remote throw encontrado recursivo -> %s"):format(
                    obj:GetFullName()
                ))
                return obj
            end
        end
    end

    return nil
end

-- ============================================================
-- MANUAL LOCAL THROW
-- ============================================================

local function getRenderedObjects()
    local folder = workspace:FindFirstChild("RenderedObjects")

    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "RenderedObjects"
        folder.Parent = workspace
    end

    return folder
end

local function makeLocalThrow(knife, targetPos)
    local handle = knife:FindFirstChild("Handle")
    local animations = knife:FindFirstChild("Animations")
    local localScript = knife:FindFirstChild("LocalScript")

    if not handle or not animations or not localScript then
        return false, "faltan Handle/Animations/LocalScript"
    end

    local handlerTemplate =
        localScript:FindFirstChild("ThrowingKinfeHandlerScript")

    if not handlerTemplate then
        return false, "no existe ThrowingKinfeHandlerScript"
    end

    local origin = handle.Position
    local delta = targetPos - origin

    if delta.Magnitude < 0.01 then
        return false, "distancia inválida"
    end

    local dir = delta.Unit
    local cf = CFrame.lookAt(origin, targetPos)

    local obj = handle:Clone()
    obj.Name = "LocalThrowingKnife"
    obj.Anchored = true
    obj.CanCollide = false
    obj.Transparency = 1
    obj.CFrame = cf

    animations:Clone().Parent = obj

    local v1 = Instance.new("Vector3Value")
    v1.Name = "VelocityV"
    v1.Value = dir
    v1.Parent = obj

    local v2 = Instance.new("Vector3Value")
    v2.Name = "VelocityVClient"
    v2.Value = dir
    v2.Parent = obj

    obj.AssemblyLinearVelocity = Vector3.zero
    obj.AssemblyAngularVelocity = Vector3.zero

    local grip = Instance.new("CFrameValue")
    grip.Name = "ToolGrip"
    grip.Value = CFrame.new(0, -1, -0.1)
    grip.Parent = obj

    obj.Parent = getRenderedObjects()

    local handler = handlerTemplate:Clone()
    handler.Parent = obj

    local creator = handler:FindFirstChild("creator")

    if creator and creator:IsA("ObjectValue") then
        creator.Value = LP
    end

    handler.Disabled = false

    local activateThrowing =
        knife:FindFirstChild("ActivateThrowing")

    if activateThrowing and activateThrowing:IsA("BindableEvent") then
        activateThrowing:Fire(obj, LP)
        print("[XERO v6] ActivateThrowing:Fire()")
    else
        warn("[XERO v6] no existe ActivateThrowing BindableEvent")
    end

    return true, nil, origin
end

local function manualThrow(knife, target)
    local targetChar, targetHum, targetRoot = getCharacter(target)

    if not targetHum or not targetRoot then
        return false, "target inválido"
    end

    local remote = resolveThrowRemote()

    if not remote then
        return false, "REMOTE THROW NO ENCONTRADO"
    end

    local aim =
        targetChar:FindFirstChild("HitboxPart")
        or targetRoot

    local targetPos = aim.Position

    local handle = knife:FindFirstChild("Handle")

    if not handle then
        return false, "Handle no existe"
    end

    local origin = handle.Position

    local okRemote, remoteErr = pcall(function()
        remote:FireServer(
            THROW_TOKEN,

            targetPos.X,
            targetPos.Y,
            targetPos.Z,

            1, 0, 0,
            0, 1, 0,
            0, 0, 1,

            origin.X,
            origin.Y,
            origin.Z
        )
    end)

    if not okRemote then
        return false, "FireServer: " .. tostring(remoteErr)
    end

    print("[XERO v6] throw remote FireServer OK")

    local okLocal, localErr =
        makeLocalThrow(knife, targetPos)

    if not okLocal then
        return false, localErr
    end

    return true
end

-- ============================================================
-- ATTACK
-- ============================================================

local function attack(knife, target)
    local _, targetHum = getCharacter(target)

    if not targetHum then
        return false
    end

    local stopWatch = startThrowWatch()

    -- Fase A: intentar la conexión nativa.
    for i = 1, MAX_NATIVE_ATTEMPTS do
        local _, humNow = getCharacter(target)

        if not humNow or humNow.Health <= 0 then
            break
        end

        print(("[XERO v6] native attempt %d/%d"):format(
            i,
            MAX_NATIVE_ATTEMPTS
        ))

        nativeActivate(knife)

        task.wait(0.18)
    end

    local seenAfterNative = stopWatch()

    if seenAfterNative > 0 then
        print(("[XERO v6] Activated nativo creó %d objetos de throw"):format(
            seenAfterNative
        ))
    else
        warn("[XERO v6] Activated nativo NO creó cuchillos")
    end

    local _, humAfterNative = getCharacter(target)

    if not humAfterNative or humAfterNative.Health <= 0 then
        print("[XERO v6] target murió con Activated nativo")
        return true
    end

    -- Fase B: fallback manual, ahora con el remote bien resuelto.
    print("[XERO v6] entrando a fallback manual...")

    local stopWatch2 = startThrowWatch()

    for i = 1, MAX_MANUAL_THROWS do
        local _, humNow = getCharacter(target)

        if not humNow or humNow.Health <= 0 then
            break
        end

        local ok, err = manualThrow(knife, target)

        if not ok then
            warn(("[XERO v6] manual throw %d falló -> %s"):format(
                i,
                tostring(err)
            ))

            -- Si el remote ni existe, no tiene sentido seguir spameando.
            if tostring(err):find("REMOTE THROW NO ENCONTRADO", 1, true) then
                break
            end
        end

        task.wait(THROW_DELAY)
    end

    local seenManual = stopWatch2()

    print(("[XERO v6] objetos de throw vistos en fallback: %d"):format(
        seenManual
    ))

    local deadline = os.clock() + 1.3

    while os.clock() < deadline do
        local _, humNow = getCharacter(target)

        if not humNow or humNow.Health <= 0 then
            print("[XERO v6] ÉXITO -> target muerto")
            return true
        end

        task.wait(0.05)
    end

    return false
end

-- ============================================================
-- CLEANUP
-- ============================================================

local function cleanup()
    running = false

    if platformConn then
        platformConn:Disconnect()
        platformConn = nil
    end

    local _, hum, root = getCharacter(LP)

    if hum then
        pcall(function()
            if root then
                hum:MoveTo(root.Position)
            end

            hum:Move(Vector3.zero, false)
        end)

        if savedAutoRotate ~= nil then
            hum.AutoRotate = savedAutoRotate
        end
    end

    savedAutoRotate = nil

    if hitbox and hitbox.Parent then
        pcall(function()
            hitbox:Destroy()
        end)
    end

    hitbox = nil

    if platform and platform.Parent then
        pcall(function()
            platform:Destroy()
        end)
    end

    platform = nil

    restoreMapCollision()

    print("[XERO v6] cleanup")
end

-- ============================================================
-- MAIN
-- ============================================================

local function main()
    print("[XERO v6] ===== NATIVE ACTIVATED + FIXED REMOTE =====")

    local target, distance = nearestEnemy()

    if not target then
        warn("[XERO v6] no hay enemigo")
        return
    end

    print(("[XERO v6] target -> %s | %.2f studs"):format(
        target.Name,
        distance
    ))

    if not createPlatform() then
        warn("[XERO v6] plataforma falló")
        return
    end

    startPlatformFollow()

    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()

    disableMapCollision()

    local knife, knifeErr = equipKnife()

    if not knife then
        warn("[XERO v6] " .. tostring(knifeErr))
        cleanup()
        return
    end

    if not createTargetHitbox(target) then
        warn("[XERO v6] hitbox falló")
        cleanup()
        return
    end

    if not approachTarget(target) then
        warn("[XERO v6] no llegué")
        cleanup()
        return
    end

    local killed = attack(knife, target)

    if killed then
        print("[XERO v6] PRUEBA COMPLETA OK")
    else
        warn("[XERO v6] movimiento OK, kill todavía NO")
    end

    task.wait(0.4)

    cleanup()
end

local ok, err = xpcall(main, debug.traceback)

if not ok then
    warn("[XERO v6] ERROR:\n" .. tostring(err))
    cleanup()
end
