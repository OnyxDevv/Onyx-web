function RT.Cleanup()
    if not RT.Alive then return end
    RT.Alive=false
    RT.Capturing=false

    for i=#RT.Connections,1,-1 do
        pcall(function() RT.Connections[i]:Disconnect() end)
        RT.Connections[i]=nil
    end

    -- Restaurar hooks directos en orden inverso.
    if type(hookfunction)=="function" then
        for i=#RT.MethodHooks,1,-1 do
            local h=RT.MethodHooks[i]
            pcall(hookfunction,h.target,h.old)
        end
    end
    table.clear(RT.MethodHooks)

    -- No intentamos restaurar __namecall aquí si otra build del hub ya lo encadenó;
    -- al cerrar sólo dejamos RT.Alive=false para volverlo pasivo.
    if gui and gui.Parent then pcall(function() gui:Destroy() end) end

    if ENV.__XERO_BIMO_GUN_INTERNALS_V2==RT then
        ENV.__XERO_BIMO_GUN_INTERNALS_V2=nil
    end
end

