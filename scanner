local function fullName(x)
    if typeof(x) ~= "Instance" then return tostring(x) end
    local ok, n = pcall(function() return x:GetFullName() end)
    return ok and n or tostring(x)
end

local function val(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "Instance" then
        return "<" .. v.ClassName .. " " .. fullName(v) .. ">"
    elseif t == "Vector3" then
        return string.format("Vector3(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return string.format("Vector2(%.3f, %.3f)", v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CFrame(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)
    elseif t == "Ray" then
        return "Ray(" .. val(v.Origin) .. " -> " .. val(v.Direction) .. ")"
    elseif t == "string" then
        local s = v
        if #s > 180 then s = s:sub(1,180) .. "..." end
        return string.format("%q", s)
    elseif t == "table" then
        if depth >= 1 then return "<table>" end
        local out, n = {}, 0
        for k,x in pairs(v) do
            n += 1
            if n > 10 then out[#out+1] = "..." break end
            out[#out+1] = tostring(k) .. "=" .. val(x, depth+1)
        end
        return "{" .. table.concat(out,", ") .. "}"
    else
        return tostring(v)
    end
end

local function argsText(...)
    local p = table.pack(...)
    local out = {}
    for i=1,p.n do out[#out+1] = "["..i.."]="..val(p[i]) end
    return table.concat(out, " | ")
end

local getUps =
    (debug and type(debug.getupvalues)=="function" and debug.getupvalues)
    or (type(getupvalues)=="function" and getupvalues)
local getConsts =
    (debug and type(debug.getconstants)=="function" and debug.getconstants)
    or (type(getconstants)=="function" and getconstants)
local getProtos =
    (debug and type(debug.getprotos)=="function" and debug.getprotos)
    or (type(getprotos)=="function" and getprotos)

local function fnInfo(fn)
    local out = {name="", source="", line="", what=""}
    if debug and type(debug.info)=="function" then
        pcall(function()
            out.name = debug.info(fn,"n") or ""
            out.source = debug.info(fn,"s") or ""
            out.line = tostring(debug.info(fn,"l") or "")
        end)
    elseif debug and type(debug.getinfo)=="function" then
        pcall(function()
            local i = debug.getinfo(fn)
            if i then
                out.name = i.name or ""
                out.source = i.source or ""
                out.line = tostring(i.linedefined or "")
                out.what = i.what or ""
            end
        end)
    end
    return out
end

local function safeUps(fn)
    if not getUps or type(fn)~="function" then return nil end
    local ok, x = pcall(getUps,fn)
    return ok and type(x)=="table" and x or nil
end

local function safeConsts(fn)
    if not getConsts or type(fn)~="function" then return nil end
    local ok, x = pcall(getConsts,fn)
    return ok and type(x)=="table" and x or nil
end

local function safeProtos(fn)
    if not getProtos or type(fn)~="function" then return nil end
    local ok, x = pcall(getProtos,fn)
    return ok and type(x)=="table" and x or nil
end

local function dumpFunction(fn, label, depth)
    if type(fn) ~= "function" then return end
    depth = depth or 0
    if depth > 3 then return end
    if RT.SeenFunctions[fn] then
        add(string.rep("  ",depth) .. label .. " = <already dumped>")
        return
    end
    RT.SeenFunctions[fn] = true

    local pad = string.rep("  ",depth)
    local i = fnInfo(fn)
    add("")
    add(pad .. "FUNCTION " .. label)
    add(pad .. "  name=" .. tostring(i.name))
    add(pad .. "  source=" .. tostring(i.source))
    add(pad .. "  line=" .. tostring(i.line))

    local cs = safeConsts(fn)
    if cs then
        add(pad .. "  CONSTANTS:")
        local shown = 0
        for k,c in pairs(cs) do
            local tc = typeof(c)
            if tc=="string" or tc=="number" or tc=="boolean" then
                shown += 1
                if shown <= 80 then
                    add(pad .. "    C["..tostring(k).."]="..val(c))
                end
            end
        end
        if shown == 0 then add(pad .. "    <none printable>") end
    else
        add(pad .. "  CONSTANTS: unavailable")
    end

    local ups = safeUps(fn)
    if ups then
        add(pad .. "  UPVALUES:")
        local childFns = {}
        for k,u in pairs(ups) do
            add(pad .. "    U["..tostring(k).."]="..val(u))
            if type(u)=="function" then
                childFns[#childFns+1] = {key=k, fn=u}
            end
        end
        for _,child in ipairs(childFns) do
            dumpFunction(child.fn, label..".U["..tostring(child.key).."]", depth+1)
        end
    else
        add(pad .. "  UPVALUES: unavailable")
    end

    local ps = safeProtos(fn)
    if ps then
        add(pad .. "  PROTOS count="..tostring(#ps))
        for idx,pfn in ipairs(ps) do
            if type(pfn)=="function" then
                dumpFunction(pfn, label..".PROTO["..idx.."]", depth+1)
            end
        end
    end
end

local function equippedTool()
    local ch = LP.Character
    return ch and ch:FindFirstChildOfClass("Tool")
end

local function relatedInstance(v, tool, gunScript)
    if typeof(v) ~= "Instance" then return false end
    if v == tool or v == gunScript then return true end
    if tool and v:IsDescendantOf(tool) then return true end
    return false
end

local function functionTouchesGun(fn, tool, gunScript)
    local ups = safeUps(fn)
    if ups then
        for _,u in pairs(ups) do
            if relatedInstance(u,tool,gunScript) then return true end
        end
    end

    local cs = safeConsts(fn)
    if cs then
        for _,c in pairs(cs) do
            if type(c)=="string" then
                local s = string.lower(c)
                if string.find(s,"gun",1,true)
                    or string.find(s,"shoot",1,true)
                    or string.find(s,"fire",1,true)
                    or string.find(s,"bullet",1,true)
                    or string.find(s,"hit",1,true)
                    or string.find(s,"raycast",1,true) then
                    return true
                end
            end
        end
    end
    return false
end

local function connectionFn(conn)
    for _,key in ipairs({"Function","Callback","ConnectedFunction"}) do
        local ok,v = pcall(function() return conn[key] end)
        if ok and type(v)=="function" then return v end
    end
end

local function scan()
    table.clear(RT.Report)
    RT.SeenFunctions = setmetatable({}, {__mode="k"})

    local tool = equippedTool()
    RT.Tool = tool
    RT.GunScript = tool and (tool:FindFirstChild("GunScript") or tool:FindFirstChildOfClass("LocalScript"))

    add("XERO BIMO GUN INTERNALS v2")
    add("Creator: Kev")
    add("PlaceId="..tostring(game.PlaceId))
    add("Player="..tostring(LP.Name))
    add("")

    if not tool then
        add("ERROR: no equipped Tool")
        return false
    end

    add("TOOL="..fullName(tool))
    add("ToolClass="..tostring(tool:GetAttribute("ToolClass")))
    add("FireRate="..tostring(tool:GetAttribute("FireRate")))
    add("GunScript="..fullName(RT.GunScript))

    add("")
    add("===== RAW DECOMPILE =====")
    if RT.GunScript and type(decompile)=="function" then
        local ok,src = pcall(decompile,RT.GunScript)
        add("ok="..tostring(ok).." length="..tostring(type(src)=="string" and #src or 0))
        add("RAW >>>"..tostring(src).."<<<")
    else
        add("decompile unavailable")
    end

    add("")
    add("===== GETSENV =====")
    if RT.GunScript and type(getsenv)=="function" then
        local ok,env = pcall(getsenv,RT.GunScript)
        if ok and type(env)=="table" then
            local count=0
            for k,v in pairs(env) do
                count += 1
                add("ENV["..tostring(k).."]="..val(v))
                if type(v)=="function" then
                    dumpFunction(v,"ENV."..tostring(k),0)
                end
            end
            add("ENV count="..tostring(count))
        else
            add("getsenv failed: "..tostring(env))
        end
    else
        add("getsenv unavailable")
    end

    add("")
    add("===== SCRIPT CLOSURE =====")
    local closureGetter =
        (type(getscriptclosure)=="function" and getscriptclosure)
        or (type(getscriptfunction)=="function" and getscriptfunction)
    if closureGetter and RT.GunScript then
        local ok,fn = pcall(closureGetter,RT.GunScript)
        add("closure ok="..tostring(ok).." type="..type(fn))
        if ok and type(fn)=="function" then
            dumpFunction(fn,"GunScriptClosure",0)
        end
    else
        add("getscriptclosure/getscriptfunction unavailable")
    end

    add("")
    add("===== TOOL.ACTIVATED CONNECTIONS =====")
    if type(getconnections)=="function" then
        local ok,cons = pcall(getconnections,tool.Activated)
        if ok and type(cons)=="table" then
            add("connections="..tostring(#cons))
            for idx,c in ipairs(cons) do
                local fn=connectionFn(c)
                add("Activated["..idx.."] fn="..tostring(fn))
                if fn then dumpFunction(fn,"Tool.Activated["..idx.."]",0) end
            end
        else
            add("getconnections failed")
        end
    else
        add("getconnections unavailable")
    end

    add("")
    add("===== GETGC GUN-RELATED FUNCTIONS =====")
    if type(getgc)=="function" then
        local ok,objs=pcall(getgc,true)
        if not ok or type(objs)~="table" then ok,objs=pcall(getgc) end
        if ok and type(objs)=="table" then
            local scanned,matched=0,0
            for _,o in ipairs(objs) do
                if type(o)=="function" then
                    scanned += 1
                    if functionTouchesGun(o,tool,RT.GunScript) then
                        matched += 1
                        if matched <= 40 then
                            dumpFunction(o,"GC_MATCH_"..matched,0)
                        end
                    end
                end
            end
            add("GC scanned="..scanned.." matched="..matched)
        else
            add("getgc failed")
        end
    else
        add("getgc unavailable")
    end

    add("")
    add("===== LIVE NETWORK CAPTURE =====")
    add("Use CAPTURAR 1 DISPARO and make one normal shot.")
    return true
end

local function installNamecall()
    if RT.NamecallHooked then return end
    if type(hookmetamethod)~="function" or type(getnamecallmethod)~="function" then
        add("namecall hook unavailable")
        return
    end

    local old
    old = hookmetamethod(game,"__namecall",function(self,...)
        local method = getnamecallmethod()
        if RT.Alive and RT.Capturing
            and os.clock() <= RT.CaptureEndsAt
            and (method=="FireServer" or method=="InvokeServer") then
            add(string.format("[NET %.6f] NAMECALL %s %s | %s",
                os.clock(),method,fullName(self),argsText(...)))
        end
        return old(self,...)
    end)
    RT.OldNamecall=old
    RT.NamecallHooked=true
end

local function hookMethod(label, methodFn)
    if type(hookfunction)~="function" or type(methodFn)~="function" then
        add(label.." direct-method hook unavailable")
        return
    end

    local old
    local replacement = function(self,...)
        if RT.Alive and RT.Capturing and os.clock() <= RT.CaptureEndsAt then
            add(string.format("[NET %.6f] DIRECT %s %s | %s",
                os.clock(),label,fullName(self),argsText(...)))
        end
        return old(self,...)
    end

    if type(newcclosure)=="function" then
        local ok,cc=pcall(newcclosure,replacement)
        if ok and cc then replacement=cc end
    end

    local ok,res=pcall(hookfunction,methodFn,replacement)
    if ok and type(res)=="function" then
        old=res
        RT.MethodHooks[#RT.MethodHooks+1]={target=methodFn,old=old,label=label}
        add(label.." direct-method hook INSTALLED")
    else
        add(label.." direct-method hook FAILED: "..tostring(res))
    end
end

local function installMethodHooks()
    if #RT.MethodHooks > 0 then return end

    local re=Instance.new("RemoteEvent")
    local rf=Instance.new("RemoteFunction")
    local ure
    pcall(function() ure=Instance.new("UnreliableRemoteEvent") end)

    local reFire
    local rfInvoke
    local ureFire
    pcall(function() reFire=re.FireServer end)
    pcall(function() rfInvoke=rf.InvokeServer end)
    if ure then pcall(function() ureFire=ure.FireServer end) end

    hookMethod("RemoteEvent.FireServer",reFire)
    hookMethod("RemoteFunction.InvokeServer",rfInvoke)
    if ureFire then hookMethod("UnreliableRemoteEvent.FireServer",ureFire) end

    re:Destroy()
    rf:Destroy()
    if ure then ure:Destroy() end
end

local function startCapture()
    if not RT.Tool or RT.Tool.Parent==nil then scan() end
    if not RT.Tool then return false end

    installNamecall()
    installMethodHooks()

    RT.Capturing=true
    RT.CaptureEndsAt=os.clock()+6
    add("")
    add("===== SHOT CAPTURE START "..tostring(os.clock()).." =====")
    add("Make ONE normal shot now.")

    local gunshot = RT.Tool:FindFirstChild("Gunshot",true)
    if gunshot and gunshot:IsA("Sound") then
        local c
        c=gunshot.Played:Connect(function(soundId)
            if RT.Capturing then
                add(string.format("[SHOT %.6f] Gunshot.Played path=%s",os.clock(),fullName(gunshot)))
            end
        end)
        track(c)
    end

    task.delay(6.05,function()
        if RT.Alive and RT.Capturing then
            RT.Capturing=false
            add("===== SHOT CAPTURE END "..tostring(os.clock()).." =====")
        end
    end)
    return true
end

local function copyText(s)
    for _,f in ipairs({setclipboard,toclipboard}) do
        if type(f)=="function" then
            local ok=pcall(f,s)
            if ok then return true end
        end
    end
    return false
end

local function save()
