local function fullName(obj)
    if typeof(obj) ~= "Instance" then return tostring(obj) end
    local ok, n = pcall(function() return obj:GetFullName() end)
    return ok and n or tostring(obj)
end

local function simple(v)
    local t = typeof(v)
    if t == "Instance" then
        return "<"..v.ClassName.." "..fullName(v)..">"
    elseif t == "Vector3" then
        return string.format("Vector3(%.3f, %.3f, %.3f)",v.X,v.Y,v.Z)
    elseif t == "CFrame" then
        local p=v.Position
        return string.format("CFrame(%.3f, %.3f, %.3f)",p.X,p.Y,p.Z)
    elseif t == "string" then
        local s=v
        if #s>160 then s=s:sub(1,160).."..." end
        return string.format("%q",s)
    elseif t=="number" or t=="boolean" or t=="nil" then
        return tostring(v)
    elseif t=="function" then
        return "<function>"
    elseif t=="table" then
        return "<table>"
    else
        return "<"..t..">"
    end
end

local getUps =
    (debug and type(debug.getupvalues)=="function" and debug.getupvalues)
    or (type(getupvalues)=="function" and getupvalues)

local getConsts =
    (debug and type(debug.getconstants)=="function" and debug.getconstants)
    or (type(getconstants)=="function" and getconstants)

local getUp =
    (debug and type(debug.getupvalue)=="function" and debug.getupvalue)
    or (type(getupvalue)=="function" and getupvalue)

local function ups(fn)
    if not getUps or type(fn)~="function" then return nil end
    local ok,x=pcall(getUps,fn)
    return ok and type(x)=="table" and x or nil
end

local function consts(fn)
    if not getConsts or type(fn)~="function" then return nil end
    local ok,x=pcall(getConsts,fn)
    return ok and type(x)=="table" and x or nil
end

local function finfo(fn)
    local name,src,line="","",""
    if debug and type(debug.info)=="function" then
        pcall(function()
            name=debug.info(fn,"n") or ""
            src=debug.info(fn,"s") or ""
            line=tostring(debug.info(fn,"l") or "")
        end)
    elseif debug and type(debug.getinfo)=="function" then
        pcall(function()
            local i=debug.getinfo(fn)
            if i then
                name=i.name or ""
                src=i.source or ""
                line=tostring(i.linedefined or "")
            end
        end)
    end
    return name,src,line
end

local function connectionFunction(conn)
    for _,k in ipairs({"Function","Callback","ConnectedFunction"}) do
        local ok,v=pcall(function() return conn[k] end)
        if ok and type(v)=="function" then return v end
    end
end

local function equippedTool()
    local ch=LP.Character
    return ch and ch:FindFirstChildOfClass("Tool")
end

local function dumpFn(fn,label,includeChildren)
    if type(fn)~="function" then
        add(label.." = not function")
        return
    end

    local name,src,line=finfo(fn)
    add("")
    add("===== FUNCTION "..label.." =====")
    add("name="..tostring(name))
    add("source="..tostring(src))
    add("line="..tostring(line))

    local cs=consts(fn)
    if cs then
        add("CONSTANTS:")
        local printed=0
        for k,v in pairs(cs) do
            local t=typeof(v)
            if t=="string" or t=="number" or t=="boolean" then
                printed+=1
                if printed>80 then
                    add("  ... capped at 80 ...")
                    break
                end
                add("  C["..tostring(k).."]="..simple(v))
            end
        end
        if printed==0 then add("  <none printable>") end
    else
        add("CONSTANTS: unavailable")
    end

    local us=ups(fn)
    local children={}
    if us then
        add("UPVALUES:")
        local n=0
        for k,v in pairs(us) do
            n+=1
            if n>30 then
                add("  ... capped at 30 ...")
                break
            end
            add("  U["..tostring(k).."]="..simple(v))
            if includeChildren and type(v)=="function" and #children<8 then
                children[#children+1]={k=k,fn=v}
            end
        end
        if n==0 then add("  <none>") end
    else
        add("UPVALUES: unavailable")
    end

    if includeChildren then
        for _,child in ipairs(children) do
            dumpFn(child.fn,label..".U["..tostring(child.k).."]",false)
        end
    end
end

local function resolve()
    table.clear(RT.Report)

    local tool=equippedTool()
    RT.Tool=tool
    RT.ActivatedFn=nil
    RT.ShootFn=nil

    add("XERO BIMO SHOOT FUNCTION SAFE v4")
    add("Creator: Kev")
    add("PlaceId="..tostring(game.PlaceId))
    add("Player="..tostring(LP.Name))
    add("")

    if not tool then
        add("ERROR: no Tool equipped")
        return false
    end

    add("TOOL="..fullName(tool))
    add("ToolClass="..tostring(tool:GetAttribute("ToolClass")))
    add("FireRate="..tostring(tool:GetAttribute("FireRate")))

    if type(getconnections)~="function" then
        add("ERROR: getconnections unavailable")
        return false
    end

    local ok,cons=pcall(getconnections,tool.Activated)
    if not ok or type(cons)~="table" or #cons==0 then
        add("ERROR: no readable Tool.Activated connections")
        return false
    end

    add("Activated connections="..tostring(#cons))

    local fn=connectionFunction(cons[1])
    if not fn then
        add("ERROR: Activated[1] callback unreadable")
        return false
    end
    RT.ActivatedFn=fn

    dumpFn(fn,"Tool.Activated[1]",false)

    -- Buscar el primer upvalue function; en tu reporte es U[5].
    local us=ups(fn)
    if not us then
        add("ERROR: Activated upvalues unavailable")
        return false
    end

    local candidate=nil
    local candidateIndex=nil

    if type(us[5])=="function" then
        candidate=us[5]
        candidateIndex=5
    else
        for k,v in pairs(us) do
            if type(v)=="function" then
                candidate=v
                candidateIndex=k
                break
            end
        end
    end

    if not candidate then
        add("ERROR: no function upvalue found in Activated callback")
        return false
    end

    RT.ShootFn=candidate
    add("")
    add("SHOOT CANDIDATE = Activated U["..tostring(candidateIndex).."]")
    dumpFn(candidate,"ShootCandidate",true)

    return true
end

local function installCallCapture()
    if RT.HookInstalled then return true end
    if not RT.ShootFn then
        if not resolve() then return false end
    end
    if type(hookfunction)~="function" then
        add("hookfunction unavailable")
        return false
    end

    local target=RT.ShootFn
    local old

    local replacement=function(...)
        if RT.Alive and RT.Capturing then
            local p=table.pack(...)
            local out={}
            for i=1,math.min(p.n,10) do
                out[#out+1]="["..i.."]="..simple(p[i])
            end
            add(string.format(
                "[CALL %.6f] ShootCandidate args(%d): %s",
                os.clock(),p.n,table.concat(out," | ")
            ))
        end
        return old(...)
    end

    if type(newcclosure)=="function" then
        local ok,cc=pcall(newcclosure,replacement)
        if ok and cc then replacement=cc end
    end

    local ok,res=pcall(hookfunction,target,replacement)
    if not ok or type(res)~="function" then
        add("hookfunction failed: "..tostring(res))
        return false
    end

    old=res
    RT.OldShoot=old
    RT.HookInstalled=true
    add("ShootCandidate call hook INSTALLED")
    return true
end

local function startCapture()
    if not RT.ShootFn then
        if not resolve() then return false end
    end

    installCallCapture()

    RT.Capturing=true
    add("")
    add("===== CALL CAPTURE START "..tostring(os.clock()).." =====")
    add("Haz UN disparo normal ahora.")

    local gunshot=RT.Tool and RT.Tool:FindFirstChild("Gunshot",true)
    if gunshot and gunshot:IsA("Sound") then
        track(gunshot.Played:Connect(function()
            if RT.Capturing then
                add(string.format("[SHOT %.6f] Gunshot.Played",os.clock()))
            end
        end))
    end

    task.delay(5,function()
        if RT.Alive and RT.Capturing then
            RT.Capturing=false
            add("===== CALL CAPTURE END "..tostring(os.clock()).." =====")
        end
    end)

    return true
end

local function copyText(s)
    for _,f in ipairs({setclipboard,toclipboard}) do
        if type(f)=="function" then
            local ok=pcall(f,s)
            if ok then return true end
        end
    end
    return false
end

