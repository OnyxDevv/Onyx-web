local function valueSummary(v, depth)
    depth = depth or 0
    if depth > 2 then return "<depth>" end

    local t = typeof(v)
    if t == "Instance" then
        return "<" .. v.ClassName .. " " .. safeFullName(v) .. ">"
    elseif t == "Vector3" then
        return string.format("Vector3(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return string.format("Vector2(%.3f, %.3f)", v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CFrame(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)
    elseif t == "Ray" then
        return "Ray(O=" .. valueSummary(v.Origin) .. ", D=" .. valueSummary(v.Direction) .. ")"
    elseif t == "table" then
        local parts = {}
        local n = 0
        for k, val in pairs(v) do
            n += 1
            if n > 8 then
                parts[#parts+1] = "..."
                break
            end
            parts[#parts+1] = tostring(k) .. "=" .. valueSummary(val, depth + 1)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    elseif t == "string" then
        local s = v
        if #s > 140 then s = s:sub(1, 140) .. "..." end
        return string.format("%q", s)
    else
        return tostring(v)
    end
end

local function dumpArgs(...)
    local args = table.pack(...)
    local out = {}
    for i = 1, args.n do
        out[#out+1] = "[" .. i .. "]=" .. valueSummary(args[i])
    end
    return table.concat(out, " | ")
end

