        "LocalPlayer: " .. tostring(LocalPlayer.Name) .. " [" .. tostring(LocalPlayer.UserId) .. "]",
        "Deep mode: " .. tostring(state.Deep),
        "Started: " .. tostring(os.date and os.date() or "?"),
        "============================================================",
        "",
    }
    return lines
end

local function startCapture()
    if state.Active then return end

    ensureFolder()
    state.Lines = sessionHeader()
    state.PendingDisk = {}
    state.Counts = {}
    state.LastWrite = {}
    state.LastEvent = {}
    state.Dropped = 0
    state.SessionStartedAt = nowClock()
    state.SessionFile = "XeroHub/Scans/Xero_KillAll_Scan_" .. unixText() .. ".txt"
    state.Active = true

    if type(state.Raw.writefile) == "function" then
        pcall(state.Raw.writefile, state.SessionFile, table.concat(state.Lines, "\n"))
    end

    attachSessionObservers()
    mark("CAPTURA INICIADA")
    snapshotCharacters("ANTES")
end

local function summaryLines()
    local entries = {}
    for category, count in pairs(state.Counts) do
        entries[#entries + 1] = {category = category, count = count}
    end
    table.sort(entries, function(a, b)
        if a.count == b.count then return a.category < b.category end
        return a.count > b.count
    end)

    pushLine("SUMMARY", "Total líneas=" .. tostring(#state.Lines) .. " | dropped=" .. tostring(state.Dropped), true)
    for _, item in ipairs(entries) do
        pushLine("SUMMARY", item.category .. " = " .. tostring(item.count), true)
    end
end

local function stopCapture()
    if not state.Active then
        flushDisk()
        return state.SessionFile
    end

    snapshotCharacters("DESPUES")
    mark("CAPTURA DETENIDA")
    summaryLines()
    state.Active = false
    disconnectSessionConnections()
    flushDisk()
    return state.SessionFile
end

local function saveNow()
    if state.Active then
        pushLine("CHECKPOINT", "Guardado manual", true)
    end
    flushDisk()
    return state.SessionFile
end

