}

local function shouldThrottleWrite(inst, prop, value)
    local key = tostring(inst) .. "|" .. tostring(prop)
    local now = nowClock()
    local minGap = TRANSFORM_PROPS[prop] and 0.018 or 0.004
    local valueText = serialize(value)
    local last = state.LastWrite[key]
    if last and last.value == valueText and (now - last.at) < 0.12 then
        return true
    end
    if last and TRANSFORM_PROPS[prop] and (now - last.at) < minGap then
        return true
    end
    state.LastWrite[key] = {at = now, value = valueText}
    return false
end

local function installMetamethodHooks()
    local hookmm = state.Raw.hookmetamethod
    local ncc = state.Raw.newcclosure or function(fn) return fn end
    local getMethod = state.Raw.getnamecallmethod

    if type(hookmm) ~= "function" or type(getMethod) ~= "function" then
        pushLine("WARN", "hookmetamethod/getnamecallmethod no disponible; se usará observación por eventos.", true)
        return
    end

    local oldNamecall
    oldNamecall = hookmm(game, "__namecall", ncc(function(self, ...)
        if not state.Active or state.HookBusy or isScannerObject(self) then
            return oldNamecall(self, ...)
        end

        local packedArgs = table.pack(...)
        local method = getMethod()
        local category = IMPORTANT_NAMECALLS[method]
        local shouldLog = category ~= nil or (state.Deep and not DEEP_IGNORE[method])

        if shouldLog then
            state.HookBusy = true
            local ok = pcall(function()
                category = category or "NAMECALL"
                local target = typeof(self) == "Instance"
                    and ("<" .. safeClass(self) .. " " .. instancePath(self) .. ">")
                    or serialize(self)
                pushLine(category,
                    tostring(method) .. " on " .. target
                    .. " args=[" .. argsToText(table.unpack(packedArgs, 1, packedArgs.n)) .. "]"
                    .. " | " .. callerInfo(5)
                )
            end)
            state.HookBusy = false
            if not ok then
                -- Nunca dejamos que el logger rompa la llamada original.
            end
        end

        return oldNamecall(self, table.unpack(packedArgs, 1, packedArgs.n))
    end))

    state.OldNamecall = oldNamecall

    local oldNewindex
    oldNewindex = hookmm(game, "__newindex", ncc(function(self, key, value)
        if state.Active and not state.HookBusy and typeof(self) == "Instance" and not isScannerObject(self) then
            state.HookBusy = true
            pcall(function()
                local prop = tostring(key)
                if not shouldThrottleWrite(self, prop, value) then
                    pushLine("PROPERTY_WRITE",
                        "<" .. safeClass(self) .. " " .. instancePath(self) .. ">."
                        .. prop .. " = " .. serialize(value)
                        .. " | " .. callerInfo(5)
                    )
                end
            end)
            state.HookBusy = false
        end
        return oldNewindex(self, key, value)
    end))

    state.OldNewindex = oldNewindex
end

local function addSessionConnection(conn)
    if conn then state.SessionConnections[#state.SessionConnections + 1] = conn end
    return conn
end

local function addCoreConnection(conn)
    if conn then state.Connections[#state.Connections + 1] = conn end
    return conn
end

local function disconnectSessionConnections()
    for i = #state.SessionConnections, 1, -1 do
        pcall(function() state.SessionConnections[i]:Disconnect() end)
        state.SessionConnections[i] = nil
    end
    state.TrackedSpecial = setmetatable({}, {__mode = "k"})
end

local function logSignal(category, obj, extra)
    if not state.Active or isScannerObject(obj) then return end
    local key = category .. "|" .. tostring(obj) .. "|" .. tostring(extra or "")
    local now = nowClock()
    local last = state.LastEvent[key]
    if last and (now - last) < 0.008 then return end
    state.LastEvent[key] = now
    pushLine(category,
        "<" .. safeClass(obj) .. " " .. instancePath(obj) .. ">"
        .. (extra and (" " .. tostring(extra)) or "")
    )
end

local function trackTool(tool)
    if state.TrackedSpecial[tool] or not tool:IsA("Tool") then return end
    state.TrackedSpecial[tool] = true

    addSessionConnection(tool.Activated:Connect(function()
        logSignal("TOOL_SIGNAL", tool, "Activated")
    end))
    addSessionConnection(tool.Deactivated:Connect(function()
        logSignal("TOOL_SIGNAL", tool, "Deactivated")
    end))
    addSessionConnection(tool.Equipped:Connect(function(mouse)
        logSignal("TOOL_SIGNAL", tool, "Equipped mouse=" .. serialize(mouse))
    end))
    addSessionConnection(tool.Unequipped:Connect(function()
        logSignal("TOOL_SIGNAL", tool, "Unequipped")
    end))
end

local function trackHumanoid(humanoid)
    if state.TrackedSpecial[humanoid] or not humanoid:IsA("Humanoid") then return end
    state.TrackedSpecial[humanoid] = true

    addSessionConnection(humanoid.Died:Connect(function()
        logSignal("HUMANOID_EVENT", humanoid, "Died")
    end))
    addSessionConnection(humanoid.HealthChanged:Connect(function(health)
        logSignal("HEALTH_EVENT", humanoid, "Health=" .. tostring(health))
    end))
    addSessionConnection(humanoid.StateChanged:Connect(function(oldState, newState)
        logSignal("STATE_EVENT", humanoid, tostring(oldState) .. " -> " .. tostring(newState))
    end))
end

local function trackInstanceSpecial(inst)
    if typeof(inst) ~= "Instance" or isScannerObject(inst) then return end
    pcall(function()
        if inst:IsA("Tool") then trackTool(inst) end
        if inst:IsA("Humanoid") then trackHumanoid(inst) end
    end)
end

local function scanSpecials(root)
    if not root then return end
    trackInstanceSpecial(root)
    local ok, descendants = pcall(function() return root:GetDescendants() end)
    if ok then
        for _, inst in ipairs(descendants) do
            trackInstanceSpecial(inst)
        end
    end
end

local function attachSessionObservers()
    local previousBusy = state.HookBusy
    state.HookBusy = true
    disconnectSessionConnections()

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then scanSpecials(p.Character) end
        local backpack = p:FindFirstChildOfClass("Backpack")
        if backpack then scanSpecials(backpack) end
    end

    addSessionConnection(game.DescendantAdded:Connect(function(inst)
        if not state.Active or isScannerObject(inst) then return end
        pushLine("INSTANCE_ADDED",
            "<" .. safeClass(inst) .. " " .. instancePath(inst) .. "> parent=" .. serialize(inst.Parent)
        )
        trackInstanceSpecial(inst)
    end))

    addSessionConnection(game.DescendantRemoving:Connect(function(inst)
        if not state.Active or isScannerObject(inst) then return end
        pushLine("INSTANCE_REMOVED", "<" .. safeClass(inst) .. " " .. instancePath(inst) .. ">")
    end))

    addSessionConnection(Players.PlayerAdded:Connect(function(p)
        pushLine("PLAYER_EVENT", "PlayerAdded " .. tostring(p.Name) .. " [" .. tostring(p.UserId) .. "]")
        addSessionConnection(p.CharacterAdded:Connect(function(char)
            pushLine("CHARACTER_EVENT", "CharacterAdded " .. instancePath(char))
            scanSpecials(char)
        end))
    end))

    for _, p in ipairs(Players:GetPlayers()) do
        addSessionConnection(p.CharacterAdded:Connect(function(char)
            if state.Active then
                pushLine("CHARACTER_EVENT", "CharacterAdded " .. instancePath(char))
            end
            scanSpecials(char)
        end))
    end
    state.HookBusy = previousBusy
end

local function wrapEnvFunction(container, key, category)
    if type(container) ~= "table" then return end
    local original = rawget(container, key)
    if type(original) ~= "function" then return end

    local wrapper
    wrapper = function(...)
        local packedArgs = table.pack(...)
        if state.Active and not state.HookBusy then
            state.HookBusy = true
            pcall(function()
                pushLine(category or "EXECUTOR_API",
                    tostring(key) .. "(" .. argsToText(table.unpack(packedArgs, 1, packedArgs.n)) .. ") | " .. callerInfo(4)
                )
            end)
            state.HookBusy = false
        end
        return original(table.unpack(packedArgs, 1, packedArgs.n))
    end

    local ok = pcall(function() container[key] = wrapper end)
    if ok then
        state.WrappedGlobals[#state.WrappedGlobals + 1] = {
            container = container,
            key = key,
            original = original,
            wrapper = wrapper,
        }
    end
end

local function installGlobalWrappers()
    local names = {
        "firetouchinterest", "fireclickdetector", "fireproximityprompt", "firesignal",
        "mouse1click", "mouse1press", "mouse1release", "mouse2click", "mouse2press", "mouse2release",
        "keypress", "keyrelease",
        "sethiddenproperty", "setscriptable", "setreadonly", "make_writeable", "make_readonly",
        "hookfunction", "hookmetamethod", "replaceclosure", "setrawmetatable",
        "queue_on_teleport", "queueonteleport",
        "request", "http_request",
        "loadstring", "require", "setthreadidentity", "setidentity",
    }

    for _, name in ipairs(names) do
        wrapEnvFunction(ENV, name, "EXECUTOR_API")
    end

    local introspectionNames = {
        "getgc", "getconnections", "getsenv", "getreg", "getrenv",
        "getupvalues", "getupvalue", "setupvalue", "getconstants", "getconstant",
        "setconstant", "getprotos", "getproto", "setproto", "getstack", "setstack",
        "getscriptclosure", "getloadedmodules", "getnilinstances",
    }
    for _, name in ipairs(introspectionNames) do
        wrapEnvFunction(ENV, name, "INTROSPECTION_API")
    end

    local debugTable = rawget(ENV, "debug") or debug
    if type(debugTable) == "table" then
        for _, name in ipairs({"getupvalue", "setupvalue", "getconstants", "getconstant", "setconstant", "getprotos", "getproto"}) do
            wrapEnvFunction(debugTable, name, "DEBUG_API")
        end
    end

    local synTable = rawget(ENV, "syn")
    if type(synTable) == "table" then
        wrapEnvFunction(synTable, "request", "HTTP_REQUEST")
    end

    local httpTable = rawget(ENV, "http")
    if type(httpTable) == "table" then
        wrapEnvFunction(httpTable, "request", "HTTP_REQUEST")
    end
end


local function installDirectHooks()
    local hookfn = state.Raw.hookfunction
    local ncc = state.Raw.newcclosure or function(fn) return fn end
    if type(hookfn) ~= "function" then return end

    -- Instance.new: permite ver también objetos creados sin Parent inmediato.
    local oldInstanceNew
    local ok = pcall(function()
        oldInstanceNew = hookfn(Instance.new, ncc(function(className, parent)
            local obj = oldInstanceNew(className, parent)
            if state.Active and not state.HookBusy then
                state.HookBusy = true
                pcall(function()
                    pushLine("INSTANCE_NEW",
                        "class=" .. tostring(className)
                        .. " -> " .. serialize(obj)
                        .. " parent=" .. serialize(parent)
                        .. " | " .. callerInfo(5)
                    )
                end)
                state.HookBusy = false
            end
            return obj
        end))
    end)
    if ok and oldInstanceNew then
        state.DirectHooks = state.DirectHooks or {}
        state.DirectHooks.InstanceNew = oldInstanceNew
    end

    -- Drawing.new, cuando el executor expone Drawing como tabla mutable.
    local drawing = rawget(ENV, "Drawing") or Drawing
    if type(drawing) == "table" and type(rawget(drawing, "new")) == "function" then
        wrapEnvFunction(drawing, "new", "DRAWING_NEW")
    end
end

local function restoreGlobalWrappers()
    for i = #state.WrappedGlobals, 1, -1 do
        local item = state.WrappedGlobals[i]
        pcall(function()
            if item.container[item.key] == item.wrapper then
                item.container[item.key] = item.original
            end
        end)
        state.WrappedGlobals[i] = nil
    end
end

local function describeCharacter(p)
    local char = p.Character
    if not char then return "no-character" end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local tool = char:FindFirstChildOfClass("Tool")

    local parts = {
        "player=" .. tostring(p.Name),
        "uid=" .. tostring(p.UserId),
        "char=" .. instancePath(char),
    }

    if hum then
        table.insert(parts, "health=" .. tostring(hum.Health))
        table.insert(parts, "state=" .. tostring(hum:GetState()))
        table.insert(parts, "platformStand=" .. tostring(hum.PlatformStand))
        table.insert(parts, "sit=" .. tostring(hum.Sit))
        table.insert(parts, "walkSpeed=" .. tostring(hum.WalkSpeed))
    end

    if hrp then
        table.insert(parts, "hrp=" .. serialize(hrp.CFrame))
        table.insert(parts, "anchored=" .. tostring(hrp.Anchored))
        table.insert(parts, "vel=" .. serialize(hrp.AssemblyLinearVelocity))
    end

    if tool then
        table.insert(parts, "tool=" .. tostring(tool.Name))
    end

    return table.concat(parts, " | ")
end

local function snapshotCharacters(label)
    mark("SNAPSHOT " .. label)
    local previousBusy = state.HookBusy
    state.HookBusy = true
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function()
            pushLine("SNAPSHOT", describeCharacter(p), true)
        end)
    end
    state.HookBusy = previousBusy
end

