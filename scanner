--[[
    XeroHub - Movement Only PoC v4
    Creator: Kev

    Corrección respecto a v3:
    - La plataforma NO viaja hacia el enemigo por sí sola.
    - La plataforma únicamente sigue debajo del personaje.
    - El Humanoid usa MoveTo() nativo hacia el enemigo.
    - WalkSpeed NO se modifica.
    - HumanoidRootPart.CFrame NO se modifica.

    Esto encaja mejor con el scanner:
    - velocidad observada ~16 studs/s (WalkSpeed normal)
    - plataforma X/Z pegada al personaje
    - plataforma invisible sirve como "piso portátil"
      mientras ActiveMaps está sin colisión.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ============================================================
-- CONFIG
-- ============================================================

local STOP_DISTANCE = 15
local PLATFORM_SIZE = Vector3.new(10, 1, 10)

-- Reenvía MoveTo para seguir a un enemigo que se esté moviendo.
local RETARGET_RATE = 0.10

-- Seguimiento de plataforma.
local PLATFORM_RATE = 1 / 30

-- ============================================================
-- STATE
-- ============================================================

local platform = nil
local collisionBackup = {}
local running = true
local followConnection = nil

-- ============================================================
-- HELPERS
-- ============================================================

local function getCharacter(player)
    local char = player and player.Character
    if not char then
        return nil
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 then
        return nil
    end

    return char, hum, root
end

local function isEnemy(player)
    if not player or player == LP then
        return false
    end

    local char, hum = getCharacter(player)
    if not char or not hum then
        return false
    end

    if LP.Team ~= nil and player.Team ~= nil and LP.Team == player.Team then
        return false
    end

    return true
end

local function nearestEnemy()
    local _, _, root = getCharacter(LP)
    if not root then
        return nil
    end

    local best
    local bestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local _, _, targetRoot = getCharacter(player)

            if targetRoot then
                local d = (targetRoot.Position - root.Position).Magnitude

                if d < bestDistance then
                    bestDistance = d
                    best = player
                end
            end
        end
    end

    return best, bestDistance
end

local function supportOffset(hum, root)
    -- Posición de soporte bajo los pies.
    return hum.HipHeight + (root.Size.Y * 0.5) + (PLATFORM_SIZE.Y * 0.5)
end

-- ============================================================
-- MAP NOCLIP
-- ============================================================

local function disableMapCollision()
    local activeMaps = workspace:FindFirstChild("ActiveMaps")

    if not activeMaps then
        warn("[XERO MOVE v4] No existe workspace.ActiveMaps")
        return
    end

    local count = 0

    for _, obj in ipairs(activeMaps:GetDescendants()) do
        if obj:IsA("BasePart") then
            collisionBackup[obj] = {
                CanCollide = obj.CanCollide,
                CanQuery = obj.CanQuery
            }

            obj.CanQuery = true
            obj.CanCollide = false
            count += 1
        end
    end

    print(("[XERO MOVE v4] Noclip aplicado a %d partes."):format(count))
end

local function restoreMapCollision()
    for obj, props in pairs(collisionBackup) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = props.CanCollide
                obj.CanQuery = props.CanQuery
            end)
        end
    end

    table.clear(collisionBackup)
end

-- ============================================================
-- PORTABLE FLOOR
-- ============================================================

local function createPlatform()
    local _, hum, root = getCharacter(LP)

    if not hum or not root then
        return nil
    end

    local offset = supportOffset(hum, root)

    local p = Instance.new("Part")
    p.Name = "p" .. tostring(math.random(100000, 999999))
    p.Size = PLATFORM_SIZE
    p.Anchored = true
    p.CanCollide = true
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.CastShadow = false
    p.CFrame = CFrame.new(
        root.Position.X,
        root.Position.Y - offset,
        root.Position.Z
    )
    p.Parent = Camera

    platform = p
    return p
end

local function startPlatformFollow()
    local accumulator = 0

    followConnection = RunService.Heartbeat:Connect(function(dt)
        if not running or not platform or not platform.Parent then
            return
        end

        accumulator += dt

        if accumulator < PLATFORM_RATE then
            return
        end

        accumulator = 0

        local _, hum, root = getCharacter(LP)

        if not hum or not root then
            return
        end

        local offset = supportOffset(hum, root)

        -- CLAVE:
        -- la plataforma sigue al jugador.
        -- No mueve al jugador.
        platform.CFrame = CFrame.new(
            root.Position.X,
            root.Position.Y - offset,
            root.Position.Z
        )
    end)
end

-- ============================================================
-- CLEANUP
-- ============================================================

local function cleanup()
    running = false

    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end

    local _, hum = getCharacter(LP)

    if hum then
        pcall(function()
            hum:Move(Vector3.zero, false)
        end)
    end

    if platform and platform.Parent then
        pcall(function()
            platform:Destroy()
        end)
    end

    platform = nil

    restoreMapCollision()

    print("[XERO MOVE v4] Cleanup terminado.")
end

-- ============================================================
-- NATIVE MOVEMENT
-- ============================================================

local function moveToEnemy(target)
    print("[XERO MOVE v4] Moviendo con Humanoid:MoveTo() nativo...")
    print("[XERO MOVE v4] WalkSpeed intacto.")
    print("[XERO MOVE v4] HRP.CFrame intacto.")

    while running do
        local _, hum, root = getCharacter(LP)
        local _, targetHum, targetRoot = getCharacter(target)

        if not hum or not root then
            return false
        end

        if not targetHum or not targetRoot then
            return false
        end

        local distance = (targetRoot.Position - root.Position).Magnitude

        if distance <= STOP_DISTANCE then
            print(("[XERO MOVE v4] Llegué a %.2f studs."):format(distance))

            pcall(function()
                hum:MoveTo(root.Position)
                hum:Move(Vector3.zero, false)
            end)

            return true
        end

        -- Movimiento Roblox normal, sin CFrame ni velocidad artificial.
        hum:MoveTo(targetRoot.Position)

        task.wait(RETARGET_RATE)
    end

    return false
end

-- ============================================================
-- MAIN
-- ============================================================

local function main()
    print("[XERO MOVE v4] ===== HUMANOID + PORTABLE FLOOR =====")

    local _, _, root = getCharacter(LP)

    if not root then
        warn("[XERO MOVE v4] Tu personaje no está listo.")
        return
    end

    local target, distance = nearestEnemy()

    if not target then
        warn("[XERO MOVE v4] No encontré enemigo vivo.")
        return
    end

    print(("[XERO MOVE v4] Target: %s | %.2f studs"):format(
        target.Name,
        distance
    ))

    -- Primero crea el piso debajo.
    if not createPlatform() then
        warn("[XERO MOVE v4] No pude crear plataforma.")
        return
    end

    startPlatformFollow()

    -- Un par de frames para asegurarnos de que ya esté sosteniendo al jugador.
    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()

    -- Después quitamos colisiones del mapa.
    disableMapCollision()

    local reached = moveToEnemy(target)

    if reached then
        print("[XERO MOVE v4] ÉXITO: llegué sin TP ni CFrame directo.")
        task.wait(1)
    else
        warn("[XERO MOVE v4] Movimiento interrumpido.")
    end

    cleanup()
end

local ok, err = xpcall(main, debug.traceback)

if not ok then
    warn("[XERO MOVE v4] ERROR:\n" .. tostring(err))
    cleanup()
end
