local function fullName(obj)
    if typeof(obj) ~= "Instance" then return tostring(obj) end
    local ok, n = pcall(function() return obj:GetFullName() end)
    return ok and n or tostring(obj)
end

local function simpleValue(v)
    local t = typeof(v)
    if t == "Instance" then
        return "<" .. v.ClassName .. " " .. fullName(v) .. ">"
    elseif t == "Vector3" then
        return string.format("Vector3(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CFrame(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z)
    elseif t == "string" then
        if #v > 120 then v = v:sub(1,120) .. "..." end
        return string.format("%q", v)
    elseif t == "number" or t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "function" then
        return "<function>"
    elseif t == "table" then
        return "<table>"
    else
        return "<" .. t .. ">"
    end
end

local getUps =
    (debug and type(debug.getupvalues) == "function" and debug.getupvalues)
    or (type(getupvalues) == "function" and getupvalues)
    or nil

local getConsts =
    (debug and type(debug.getconstants) == "function" and debug.getconstants)
    or (type(getconstants) == "function" and getconstants)
    or nil

local function safeUpvalues(fn)
    if not getUps or type(fn) ~= "function" then return nil end
    local ok, ups = pcall(getUps, fn)
    if ok and type(ups) == "table" then return ups end
    return nil
end

local function safeConstants(fn)
    if not getConsts or type(fn) ~= "function" then return nil end
    local ok, cs = pcall(getConsts, fn)
    if ok and type(cs) == "table" then return cs end
    return nil
end

local function functionInfo(fn)
    local name, source = "", ""
    if debug and type(debug.info) == "function" then
        pcall(function()
            name = debug.info(fn, "n") or ""
            source = debug.info(fn, "s") or ""
        end)
    elseif debug and type(debug.getinfo) == "function" then
        pcall(function()
            local i = debug.getinfo(fn)
            name = i and i.name or ""
            source = i and i.source or ""
        end)
    end
    return tostring(name), tostring(source)
end

local function dumpFunctionShallow(fn, label)
    if type(fn) ~= "function" then
        add(label .. ": not a function")
        return
    end

    local name, source = functionInfo(fn)
    add("")
    add("FUNCTION " .. label)
    add("name=" .. name)
    add("source=" .. source)

    local ups = safeUpvalues(fn)
    if ups then
        add("UPVALUES:")
        local count = 0
        for k, v in pairs(ups) do
            count += 1
            if count > 20 then
                add("  ... capped at 20 ...")
                break
            end
            add("  U[" .. tostring(k) .. "]=" .. simpleValue(v))
        end
        if count == 0 then add("  <none>") end
    else
        add("UPVALUES: unavailable")
    end

    local cs = safeConstants(fn)
    if cs then
        add("CONSTANTS:")
        local count = 0
        for k, v in pairs(cs) do
            local t = typeof(v)
            if t == "string" or t == "number" or t == "boolean" then
                count += 1
                if count > 40 then
                    add("  ... capped at 40 ...")
                    break
                end
                add("  C[" .. tostring(k) .. "]=" .. simpleValue(v))
            end
        end
        if count == 0 then add("  <none printable>") end
    else
        add("CONSTANTS: unavailable")
    end
end

local function equippedTool()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Tool") or nil
end

local function connectionFunction(conn)
    for _, key in ipairs({"Function","Callback","ConnectedFunction"}) do
        local ok, v = pcall(function() return conn[key] end)
        if ok and type(v) == "function" then
            return v
        end
    end
    return nil
end

local function scanSafe()
    table.clear(RT.Report)

    local tool = equippedTool()
    RT.Tool = tool
    RT.GunScript = tool and (tool:FindFirstChild("GunScript") or tool:FindFirstChildOfClass("LocalScript"))

    add("XERO BIMO GUN INTERNALS SAFE v3")
    add("Creator: Kev")
    add("PlaceId=" .. tostring(game.PlaceId))
    add("Player=" .. tostring(LP.Name))
    add("")

    if not tool then
        add("ERROR: no equipped Tool")
        return false
    end

    add("TOOL=" .. fullName(tool))
    add("ToolClass=" .. tostring(tool:GetAttribute("ToolClass")))
    add("FireRate=" .. tostring(tool:GetAttribute("FireRate")))
    add("GunScript=" .. fullName(RT.GunScript))

    add("")
    add("===== CHILDREN =====")
    local childCount = 0
    for _, obj in ipairs(tool:GetDescendants()) do
        childCount += 1
        if childCount > 80 then
            add("... descendants capped at 80 ...")
            break
        end
        add(obj.ClassName .. " | " .. fullName(obj))
    end

    add("")
    add("===== DECOMPILE RAW =====")
    if RT.GunScript and type(decompile) == "function" then
        local ok, src = pcall(decompile, RT.GunScript)
        add("ok=" .. tostring(ok))
        add("type=" .. type(src))
        add("length=" .. tostring(type(src) == "string" and #src or 0))
        if type(src) == "string" then
            local clipped = src
            if #clipped > 3000 then
                clipped = clipped:sub(1,3000) .. "\n... clipped ..."
            end
            add("RAW >>>")
            add(clipped)
            add("<<< RAW")
        else
            add("value=" .. tostring(src))
        end
    else
        add("decompile unavailable")
    end

    add("")
    add("===== GETSENV =====")
    if RT.GunScript and type(getsenv) == "function" then
        local ok, env = pcall(getsenv, RT.GunScript)
        if ok and type(env) == "table" then
            local fnCount = 0
            local keyCount = 0

            for k, v in pairs(env) do
                keyCount += 1
                if keyCount > 120 then
                    add("ENV ... capped at 120 keys ...")
                    break
                end

                add("ENV[" .. tostring(k) .. "]=" .. simpleValue(v))

                if type(v) == "function" and fnCount < 8 then
                    fnCount += 1
                    dumpFunctionShallow(v, "ENV." .. tostring(k))
                end
            end

            add("ENV keys scanned=" .. tostring(keyCount))
            add("ENV functions dumped=" .. tostring(fnCount))
        else
            add("getsenv failed: " .. tostring(env))
        end
    else
        add("getsenv unavailable")
    end

    add("")
    add("===== TOOL.ACTIVATED =====")
    if type(getconnections) == "function" then
        local ok, cons = pcall(getconnections, tool.Activated)
        if ok and type(cons) == "table" then
            add("connections=" .. tostring(#cons))
            local dumped = 0

            for i, conn in ipairs(cons) do
                if i > 12 then
                    add("... connections capped at 12 ...")
                    break
                end

                local fn = connectionFunction(conn)
                add("Activated[" .. tostring(i) .. "] function=" .. tostring(fn ~= nil))

                if fn and dumped < 6 then
                    dumped += 1
                    dumpFunctionShallow(fn, "Tool.Activated[" .. tostring(i) .. "]")
                end
            end
        else
            add("getconnections failed")
        end
    else
        add("getconnections unavailable")
    end

    add("")
    add("===== LIVE NETWORK =====")
    add("Use CAPTURAR DISPARO and fire ONE normal shot.")

    return true
end

local function formatArgs(...)
    local p = table.pack(...)
    local out = {}
    for i = 1, math.min(p.n, 12) do
        out[#out+1] = "[" .. i .. "]=" .. simpleValue(p[i])
    end
    return table.concat(out, " | ")
end

local function installNetworkHook()
    if RT.Hooked then return true end
    if type(hookmetamethod) ~= "function"
        or type(getnamecallmethod) ~= "function" then
        add("NETWORK HOOK unavailable")
        return false
    end

    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if RT.Alive
            and RT.Capturing
            and os.clock() <= RT.CaptureEndsAt
            and (method == "FireServer" or method == "InvokeServer") then

            add(string.format(
                "[NET %.6f] %s | %s | %s",
                os.clock(),
                method,
                fullName(self),
                formatArgs(...)
            ))
        end

        return old(self, ...)
    end)

    RT.Hooked = true
    return true
end

local function startCapture()
    if not RT.Tool or RT.Tool.Parent == nil then
        scanSafe()
    end
    if not RT.Tool then return false end

    installNetworkHook()

    RT.Capturing = true
    RT.CaptureEndsAt = os.clock() + 5

    add("")
    add("===== CAPTURE START " .. tostring(os.clock()) .. " =====")
    add("Haz UN disparo normal ahora.")

    local gunshot = RT.Tool:FindFirstChild("Gunshot", true)
    if gunshot and gunshot:IsA("Sound") then
        local connection
        connection = gunshot.Played:Connect(function()
            if RT.Alive and RT.Capturing then
                add(string.format(
                    "[SHOT %.6f] Gunshot.Played | %s",
                    os.clock(),
                    fullName(gunshot)
                ))
            end
        end)
        track(connection)
    end

    task.delay(5.1, function()
        if RT.Alive and RT.Capturing then
            RT.Capturing = false
            add("===== CAPTURE END " .. tostring(os.clock()) .. " =====")
        end
    end)

    return true
end

local function copyText(s)
    for _, fn in ipairs({setclipboard, toclipboard}) do
        if type(fn) == "function" then
            local ok = pcall(fn, s)
            if ok then return true end
        end
    end
    return false
end

local function save()
    RT.Capturing = false
    local text = table.concat(RT.Report, "\n")

    local wrote = false
    if type(writefile) == "function" then
        wrote = pcall(
            writefile,
            "Xero_Bimo_GunInternals_SAFE_v3.txt",
            text
        )
    end

    local copied = copyText(text)
    return wrote, copied
end

