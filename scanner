local function nowClock()
    return os.clock()
end

local function unixText()
    local ok, value = pcall(function()
        return os.date("%Y%m%d_%H%M%S")
    end)
    if ok and value then return value end
    return tostring(math.floor(nowClock() * 1000))
end

local function elapsed()
    if state.SessionStartedAt <= 0 then return 0 end
    return nowClock() - state.SessionStartedAt
end

local function safeName(inst)
    local ok, name = pcall(function() return inst.Name end)
    return ok and tostring(name) or "?"
end

local function safeClass(inst)
    local ok, className = pcall(function() return inst.ClassName end)
    return ok and tostring(className) or "?"
end

local function instancePath(inst)
    if typeof(inst) ~= "Instance" then
        return tostring(inst)
    end

    local names = {}
    local current = inst
    local depth = 0
    while current and depth < 12 do
        depth = depth + 1
        table.insert(names, 1, safeName(current))
        local ok, parent = pcall(function() return current.Parent end)
        if not ok then break end
        current = parent
    end

    if current then
        table.insert(names, 1, "...")
    end

    return table.concat(names, ".")
end

local function isScannerObject(inst)
    if typeof(inst) ~= "Instance" then return false end
    local current = inst
    local depth = 0
    while current and depth < 20 do
        if current == state.UiRoot then return true end
        local ok, parent = pcall(function() return current.Parent end)
        if not ok then break end
        current = parent
        depth = depth + 1
    end
    return false
end

local function shortString(s, limit)
    s = tostring(s or "")
    limit = limit or 180
    s = s:gsub("\r", "\\r"):gsub("\n", "\\n"):gsub("\t", "\\t")
    if #s > limit then
        return s:sub(1, limit) .. "...<" .. tostring(#s) .. " chars>"
    end
    return s
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    local kind = typeof(value)
    if kind == "nil" then return "nil" end
    if kind == "string" then return string.format("%q", shortString(value, 220)) end
    if kind == "number" or kind == "boolean" then return tostring(value) end

    if kind == "Instance" then
        return string.format("<%s %s>", safeClass(value), instancePath(value))
    end

    if kind == "Vector3" or kind == "Vector2" or kind == "CFrame"
        or kind == "Color3" or kind == "UDim" or kind == "UDim2"
        or kind == "BrickColor" or kind == "Ray" or kind == "Rect"
        or kind == "NumberRange" or kind == "NumberSequence"
        or kind == "ColorSequence" or kind == "EnumItem" then
        return tostring(value)
    end

    if kind == "table" then
        if seen[value] then return "<cycle>" end
        if depth >= 2 then return "<table>" end
        seen[value] = true

        local parts = {}
        local count = 0
        for k, v in pairs(value) do
            count = count + 1
            if count > 12 then
                table.insert(parts, "...")
                break
            end
            table.insert(parts, "[" .. serialize(k, depth + 1, seen) .. "]=" .. serialize(v, depth + 1, seen))
        end
        seen[value] = nil
        return "{" .. table.concat(parts, ", ") .. "}"
    end

    local ok, textValue = pcall(tostring, value)
    return ok and ("<" .. kind .. " " .. shortString(textValue, 120) .. ">") or ("<" .. kind .. ">")
end

local function argsToText(...)
    local packed = table.pack(...)
    local out = {}
    local maxArgs = math.min(packed.n, 14)
    for i = 1, maxArgs do
        out[i] = serialize(packed[i])
    end
    if packed.n > maxArgs then
        out[#out + 1] = "... +" .. tostring(packed.n - maxArgs) .. " args"
    end
    return table.concat(out, ", ")
end

local function callerInfo(startLevel)
    local parts = {}

    if state.Raw.getcallingscript then
        local ok, scriptObj = pcall(state.Raw.getcallingscript)
        if ok and scriptObj then
            table.insert(parts, "script=" .. instancePath(scriptObj))
        end
    end

    if debug and debug.info then
        local start = startLevel or 4
        for level = start, start + 4 do
            local ok, src, line, name = pcall(function()
                return debug.info(level, "sln")
            end)
            if ok and src then
                local piece = shortString(src, 80) .. ":" .. tostring(line or "?")
                if name and name ~= "" then piece = piece .. " " .. tostring(name) end
                table.insert(parts, piece)
                if #parts >= 3 then break end
            end
        end
    end

    if #parts == 0 then return "caller=?" end
    return table.concat(parts, " | ")
end

local function ensureFolder()
    local mk = state.Raw.makefolder
    local isf = state.Raw.isfolder
    if type(mk) ~= "function" then return end

    local folders = {"XeroHub", "XeroHub/Scans"}
    for _, folder in ipairs(folders) do
        local exists = false
        if type(isf) == "function" then
            pcall(function() exists = isf(folder) end)
        end
        if not exists then pcall(mk, folder) end
    end
end

local function countCategory(category)
    state.Counts[category] = (state.Counts[category] or 0) + 1
end

local function rawAppend(textValue)
    if not state.SessionFile or textValue == "" then return end

    if type(state.Raw.appendfile) == "function" then
        pcall(state.Raw.appendfile, state.SessionFile, textValue)
        return
    end

    if type(state.Raw.writefile) == "function" then
        pcall(state.Raw.writefile, state.SessionFile, table.concat(state.Lines, "\n") .. "\n")
    end
end

local function flushDisk()
    if #state.PendingDisk == 0 then return end
    local chunk = table.concat(state.PendingDisk, "\n") .. "\n"
    state.PendingDisk = {}
    rawAppend(chunk)
    state.Dirty = false
end

local function pushLine(category, message, force)
    if not force and not state.Active then return end

    if #state.Lines >= state.MaxLines then
        state.Dropped = state.Dropped + 1
        return
    end

    category = tostring(category or "INFO")
    message = tostring(message or "")
    countCategory(category)

    local line = string.format("[%08.3f] %-16s %s", elapsed(), category, message)
    state.Lines[#state.Lines + 1] = line
    state.PendingDisk[#state.PendingDisk + 1] = line
    state.Dirty = true

    if #state.PendingDisk >= 100 then
        flushDisk()
    end
end

local function mark(textValue)
    pushLine("==========", "========== " .. tostring(textValue) .. " ==========", true)
    flushDisk()
end

