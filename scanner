local function rescan()
    local tool = equippedTool()
    if tool ~= RT.Tool then
        RT.Tool = tool
        RT.BeamFunction = nil
    end

    if tool and isGunTool(tool) and not RT.BeamFunction then
        RT.BeamFunction = select(1, findNativeBeam(tool))
    end
end

track(RunService.Heartbeat:Connect(function()
    if not RT.Alive then return end

    local now = os.clock()
    if now - RT.LastScan >= 0.20 then
        RT.LastScan = now
        rescan()
        RT.TargetPlayer, RT.TargetPart = getTarget()
    end

    local toolText = RT.Tool and RT.Tool.Name or "ninguna"
    local beamText = RT.BeamFunction and "ENCONTRADA" or "NO ENCONTRADA"
    local targetText = RT.TargetPlayer and RT.TargetPlayer.Name or "ninguno"
    status.Text =
        "Pistola: " .. toolText ..
        "\nShootLocalBeam: " .. beamText ..
        "\nTarget: " .. targetText
end))

local function fireNativeBeam()
    rescan()

    local tool = RT.Tool
    local beam = RT.BeamFunction
    local target = RT.TargetPart
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not tool or not isGunTool(tool) then
        status.Text = "ERROR: equipa una pistola."
        return
    end
    if not beam then
        local _, err = findNativeBeam(tool)
        status.Text = "ERROR: " .. tostring(err or "ShootLocalBeam no encontrada")
        return
    end
    if not target or not target.Parent then
        status.Text = "ERROR: no hay target visible."
        return
    end
    if not hrp then
        status.Text = "ERROR: no hay HumanoidRootPart."
        return
    end

    local now = os.clock()
    if now - RT.LastShot < 2.55 then
        status.Text = "Cooldown nativo: espera un poco."
        return
    end
    RT.LastShot = now

    local ok, err = pcall(beam, target.Position, hrp.Position, tool)
    if ok then
        status.Text =
            "LLAMADA NATIVA OK\nTarget: " ..
            tostring(RT.TargetPlayer and RT.TargetPlayer.Name or "?") ..
            "\nMira si salió Gunshot/beam y si contó daño."
    else
        status.Text = "ERROR al llamar ShootLocalBeam:\n" .. tostring(err)
        warn("[Xero Bimo NativeBeam] " .. tostring(err))
    end
end

track(fireBtn.Activated:Connect(fireNativeBeam))
track(close.Activated:Connect(function()
    if RT.Cleanup then RT.Cleanup() end
end))

-- Drag simple
do
    local dragging, dragStart, startPos = false, nil, nil
    track(card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = card.Position
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and dragStart
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            card.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function RT.Cleanup()
    if not RT.Alive then return end
    RT.Alive = false
    for i = #RT.Connections, 1, -1 do
        pcall(function() RT.Connections[i]:Disconnect() end)
        RT.Connections[i] = nil
    end
    if gui and gui.Parent then gui:Destroy() end
    if ENV.__XERO_BIMO_NATIVEBEAM_PROBE == RT then
        ENV.__XERO_BIMO_NATIVEBEAM_PROBE = nil
    end
end

