--[[
    XeroHub - Movement Only PoC v3
    Creator: Kev

    PRUEBA DE AISLAMIENTO:
    - NO toca HumanoidRootPart.CFrame
    - NO usa hookmetamethod
    - NO usa getconnections/firesignal
    - NO usa cuchillo
    - NO crea hitbox

    Solo replica la parte observada en el scanner:
      * plataforma invisible 10x1x10
      * Anchored = true
      * CanCollide = true
      * CanQuery = false
      * CanTouch = false
      * Parent = CurrentCamera
      * movimiento continuo hacia el enemigo
      * geometría de ActiveMaps con CanCollide=false / CanQuery=true
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- =========================
-- CONFIG
-- =========================

local SPEED = 16                 -- aprox. lo observado en el log
local STOP_DISTANCE = 15
local PLATFORM_SIZE = Vector3.new(10, 1, 10)

-- El otro script parecía escribir la posición ~30 veces/s.
local UPDATE_RATE = 1 / 30

-- =========================
-- STATE
-- =========================

local platform
local backup = {}
local running = true

-- =========================
-- HELPERS
-- =========================

local function getCharacter(player)
    local char = player and player.Character
    if not char then
        return nil
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 then
        return nil
    end

    return char, hum, root
end

local function isEnemy(player)
    if not player or player == LP then
        return false
    end

    local char, hum = getCharacter(player)
    if not char or not hum then
        return false
    end

    if LP.Team ~= nil and player.Team ~= nil and LP.Team == player.Team then
        return false
    end

    return true
end

local function nearestEnemy()
    local _, _, root = getCharacter(LP)
    if not root then
        return nil
    end

    local best
    local bestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local _, _, targetRoot = getCharacter(player)

            if targetRoot then
                local d = (targetRoot.Position - root.Position).Magnitude

                if d < bestDistance then
                    bestDistance = d
                    best = player
                end
            end
        end
    end

    return best, bestDistance
end

local function getPlatformOffset(hum, root)
    -- Scanner:
    -- HRP ~Y 123.09
    -- plataforma ~Y 119.59
    -- diferencia ~3.50
    --
    -- Esto suele coincidir con:
    -- HipHeight + medio HRP + media plataforma.
    return hum.HipHeight + (root.Size.Y * 0.5) + (PLATFORM_SIZE.Y * 0.5)
end

-- =========================
-- MAP COLLISION
-- =========================

local function disableMapCollision()
    local activeMaps = workspace:FindFirstChild("ActiveMaps")

    if not activeMaps then
        warn("[XERO MOVE TEST] No existe workspace.ActiveMaps")
        return
    end

    local count = 0

    for _, obj in ipairs(activeMaps:GetDescendants()) do
        if obj:IsA("BasePart") then
            backup[obj] = {
                CanCollide = obj.CanCollide,
                CanQuery = obj.CanQuery
            }

            -- Exactamente el patrón que vimos en el log.
            obj.CanQuery = true
            obj.CanCollide = false

            count += 1
        end
    end

    print(("[XERO MOVE TEST] Noclip aplicado a %d partes"):format(count))
end

local function restoreMapCollision()
    for obj, props in pairs(backup) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = props.CanCollide
                obj.CanQuery = props.CanQuery
            end)
        end
    end

    table.clear(backup)
end

-- =========================
-- PLATFORM
-- =========================

local function createPlatform()
    local _, hum, root = getCharacter(LP)

    if not hum or not root then
        return nil
    end

    local offset = getPlatformOffset(hum, root)

    local p = Instance.new("Part")
    p.Name = "p" .. tostring(math.random(100000, 999999))
    p.Size = PLATFORM_SIZE
    p.Anchored = true
    p.CanCollide = true
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.CastShadow = false
    p.CFrame = CFrame.new(root.Position - Vector3.new(0, offset, 0))
    p.Parent = Camera

    platform = p
    return p
end

local function cleanup()
    running = false

    if platform and platform.Parent then
        pcall(function()
            platform:Destroy()
        end)
    end

    platform = nil
    restoreMapCollision()

    print("[XERO MOVE TEST] Cleanup terminado.")
end

-- =========================
-- MOVEMENT
-- =========================

local function moveToward(target)
    local _, hum, root = getCharacter(LP)
    local _, targetHum, targetRoot = getCharacter(target)

    if not hum or not root or not targetRoot or not platform then
        return false
    end

    local offset = getPlatformOffset(hum, root)

    print("[XERO MOVE TEST] Moviendo plataforma...")
    print("[XERO MOVE TEST] NO se escribirá el CFrame de tu HRP.")

    local accumulator = 0

    while running do
        local dt = RunService.Heartbeat:Wait()
        accumulator += dt

        if accumulator < UPDATE_RATE then
            continue
        end

        local stepDt = accumulator
        accumulator = 0

        local _, currentHum, currentRoot = getCharacter(LP)
        local _, currentTargetHum, currentTargetRoot = getCharacter(target)

        if not currentHum or not currentRoot then
            return false
        end

        if not currentTargetHum or not currentTargetRoot then
            return false
        end

        local distance = (currentTargetRoot.Position - currentRoot.Position).Magnitude

        if distance <= STOP_DISTANCE then
            print(("[XERO MOVE TEST] Llegué a %.2f studs"):format(distance))
            return true
        end

        -- Importante:
        -- SOLO movemos la plataforma.
        -- Nunca hacemos root.CFrame = ...
        local goal =
            currentTargetRoot.Position
            - Vector3.new(0, offset, 0)

        local pos = platform.Position
        local delta = goal - pos

        if delta.Magnitude > 0.001 then
            local step = math.min(SPEED * stepDt, delta.Magnitude)
            local nextPos = pos + delta.Unit * step

            platform.CFrame = CFrame.new(nextPos)
        end
    end

    return false
end

-- =========================
-- MAIN
-- =========================

local function main()
    print("[XERO MOVE TEST] ===== v3 MOVEMENT ONLY =====")

    local _, _, root = getCharacter(LP)

    if not root then
        warn("[XERO MOVE TEST] Tu personaje no está listo.")
        return
    end

    local target, distance = nearestEnemy()

    if not target then
        warn("[XERO MOVE TEST] No hay enemigo vivo.")
        return
    end

    print(("[XERO MOVE TEST] Target: %s | %.2f studs"):format(
        target.Name,
        distance
    ))

    disableMapCollision()

    if not createPlatform() then
        warn("[XERO MOVE TEST] No pude crear la plataforma.")
        cleanup()
        return
    end

    local reached = moveToward(target)

    if reached then
        print("[XERO MOVE TEST] Movimiento completado SIN tocar HRP.CFrame.")
        task.wait(1)
    else
        warn("[XERO MOVE TEST] Movimiento interrumpido.")
    end

    cleanup()
end

local ok, err = xpcall(main, debug.traceback)

if not ok then
    warn("[XERO MOVE TEST] ERROR:\n" .. tostring(err))
    cleanup()
end
