local rawGetConnections =
    (type(getconnections) == "function" and getconnections)
    or (type(get_signal_cons) == "function" and get_signal_cons)
    or nil

local rawGetUpvalues =
    (debug and type(debug.getupvalues) == "function" and debug.getupvalues)
    or (type(getupvalues) == "function" and getupvalues)
    or nil

local rawGetUpvalue =
    (debug and type(debug.getupvalue) == "function" and debug.getupvalue)
    or (type(getupvalue) == "function" and getupvalue)
    or nil

local function getUpvaluesSafe(fn)
    if type(fn) ~= "function" then return nil end

    if rawGetUpvalues then
        local ok, ups = pcall(rawGetUpvalues, fn)
        if ok and type(ups) == "table" then
            return ups
        end
    end

    if rawGetUpvalue then
        local out = {}
        local found = false

        for i = 1, 40 do
            local ok, a, b = pcall(rawGetUpvalue, fn, i)
            if not ok then break end

            -- Algunas implementaciones: name, value
            -- Otras: value
            local value
            if b ~= nil or type(a) == "string" then
                value = b
            else
                value = a
            end

            if value == nil and a == nil and b == nil then
                -- No asumimos fin inmediatamente; pero tras unos nil cortamos.
                if i > 20 then break end
            else
                out[i] = value
                found = true
            end
        end

        if found then return out end
    end

    return nil
end

local function connectionFunction(conn)
    if not conn then return nil end

    local candidates = {"Function", "Callback", "ConnectedFunction"}
    for _, key in ipairs(candidates) do
        local ok, value = pcall(function() return conn[key] end)
        if ok and type(value) == "function" then
            return value
        end
    end

    return nil
end

local function equippedTool()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Tool") or nil
end

local function isGunTool(tool)
    if not tool then return false end
    local handle = tool:FindFirstChild("Handle")
    return (handle and handle:FindFirstChild("Gunshot") ~= nil)
        or (tool:FindFirstChild("fire") ~= nil and tool:FindFirstChild("showBeam") ~= nil)
end

local function getGunRemotes(tool)
    if not tool then return nil, nil end
    local fireRemote = tool:FindFirstChild("fire")
    local showBeam = tool:FindFirstChild("showBeam")
    return fireRemote, showBeam
end

local function functionContainsExactRemote(fn, remote)
    if not remote or type(fn) ~= "function" then return false end
    local ups = getUpvaluesSafe(fn)
    if not ups then return false end

    for _, value in pairs(ups) do
        if value == remote then return true end
    end
    return false
end

local function isBeamFunction(fn, tool)
    if type(fn) ~= "function" or not tool then return false end

    local fireRemote, showBeam = getGunRemotes(tool)
    if not fireRemote or not showBeam then return false end

    local ups = getUpvaluesSafe(fn)
    if not ups then return false end

    local hasFire, hasShow = false, false
    for _, value in pairs(ups) do
        if value == fireRemote then
            hasFire = true
        elseif value == showBeam then
            hasShow = true
        end
    end

    return hasFire and hasShow
end

local function findBeamInsideFunction(fn, tool, visited, depth)
    if type(fn) ~= "function" then return nil end
    visited = visited or {}
    depth = depth or 0
    if visited[fn] or depth > 4 then return nil end
    visited[fn] = true

    if isBeamFunction(fn, tool) then
        return fn
    end

    local ups = getUpvaluesSafe(fn)
    if not ups then return nil end

    for _, value in pairs(ups) do
        if type(value) == "function" then
            if isBeamFunction(value, tool) then
                return value
            end
            local found = findBeamInsideFunction(value, tool, visited, depth + 1)
            if found then return found end
        end
    end

    return nil
end

local function findViaActivated(tool)
    if not rawGetConnections then
        return nil, nil, "getconnections no disponible"
    end

    local ok, cons = pcall(rawGetConnections, tool.Activated)
    if not ok or type(cons) ~= "table" then
        return nil, nil, "no pude leer Tool.Activated"
    end

    local readable = 0
    for _, conn in ipairs(cons) do
        local fn = connectionFunction(conn)
        if fn then
            readable += 1
            local beam = findBeamInsideFunction(fn, tool)
            if beam then
                -- Intentamos además recuperar Shoot como la función padre inmediata
                local ups = getUpvaluesSafe(fn)
                if ups then
                    for _, value in pairs(ups) do
                        if type(value) == "function" then
                            local nested = findBeamInsideFunction(value, tool)
                            if nested == beam then
                                return beam, value, "Activated readable=" .. tostring(readable)
                            end
                        end
                    end
                end
                return beam, nil, "Activated readable=" .. tostring(readable)
            end
        end
    end

    return nil, nil,
        "Activated connections=" .. tostring(#cons) ..
        ", callbacks legibles=" .. tostring(readable)
end

local function getGCObjects()
    if type(getgc) ~= "function" then
        return nil, "getgc no disponible"
    end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then
        ok, objects = pcall(getgc)
    end

    if not ok or type(objects) ~= "table" then
        return nil, "getgc falló"
    end
    return objects
end

local function findViaExactRemoteSignature(tool)
    local objects, err = getGCObjects()
    if not objects then return nil, nil, err end

    local functionCount = 0
    local upvalueReadable = 0

    for _, obj in ipairs(objects) do
        if type(obj) == "function" then
            functionCount += 1
            local ups = getUpvaluesSafe(obj)
            if ups then
                upvalueReadable += 1
                if isBeamFunction(obj, tool) then
                    return obj, nil,
                        "GC funcs=" .. tostring(functionCount) ..
                        ", upvalues legibles=" .. tostring(upvalueReadable)
                end
            end
        end
    end

    return nil, nil,
        "GC funcs=" .. tostring(functionCount) ..
        ", upvalues legibles=" .. tostring(upvalueReadable)
end

local function findViaShootTree(tool)
    local objects, err = getGCObjects()
    if not objects then return nil, nil, err end

    local scanned = 0
    for _, obj in ipairs(objects) do
        if type(obj) == "function" then
            scanned += 1
            local beam = findBeamInsideFunction(obj, tool)
            if beam and beam ~= obj then
                return beam, obj, "tree scanned=" .. tostring(scanned)
            end
        end
    end

    return nil, nil, "tree scanned=" .. tostring(scanned)
end

local function discover(tool)
    if not tool or not isGunTool(tool) then
        return nil, nil, "ninguna", "Equipa la pistola primero."
    end

    local fireRemote, showBeam = getGunRemotes(tool)
    if not fireRemote or not showBeam then
        return nil, nil, "ninguna", "La Tool no tiene fire/showBeam."
    end

    local beam, shoot, detail = findViaActivated(tool)
    if beam then
        return beam, shoot, "Tool.Activated", detail
    end

    local firstDetail = detail

    beam, shoot, detail = findViaExactRemoteSignature(tool)
    if beam then
        return beam, shoot, "GC remote signature", detail
    end

    local secondDetail = detail

    beam, shoot, detail = findViaShootTree(tool)
    if beam then
        return beam, shoot, "GC recursive tree", detail
    end

    return nil, nil, "NO ENCONTRADA",
        "Activated: " .. tostring(firstDetail) ..
        "\nGC signature: " .. tostring(secondDetail) ..
        "\nGC tree: " .. tostring(detail) ..
        "\ngetupvalues=" .. tostring(rawGetUpvalues ~= nil) ..
        " getupvalue=" .. tostring(rawGetUpvalue ~= nil) ..
        " getconnections=" .. tostring(rawGetConnections ~= nil)
end

local function sameTeam(p)
    if not p or p == LP then return true end
    if LP.Team ~= nil and p.Team ~= nil then
        return LP.Team == p.Team
    end
    return false
end

local function getTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return nil, nil end

    local vp = camera.ViewportSize
    local cx, cy = vp.X * 0.5, vp.Y * 0.5
    local bestPlayer, bestPart, bestScore = nil, nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not sameTeam(p) then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local part = ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart"))
            if hum and hum.Health > 0 and part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    local dx, dy = pos.X - cx, pos.Y - cy
                    local score = dx*dx + dy*dy
                    if score < bestScore then
                        bestScore = score
                        bestPlayer = p
                        bestPart = part
                    end
                end
            end
        end
    end

    return bestPlayer, bestPart
end

