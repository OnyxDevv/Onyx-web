local function track(c)
    if c then RT.Connections[#RT.Connections+1] = c end
    return c
end

local function fnInfo(fn)
    local name, source = "", ""
    if debug and type(debug.info) == "function" then
        pcall(function()
            name = debug.info(fn, "n") or ""
            source = debug.info(fn, "s") or ""
        end)
    elseif debug and type(debug.getinfo) == "function" then
        pcall(function()
            local i = debug.getinfo(fn)
            name = (i and i.name) or ""
            source = (i and i.source) or ""
        end)
    end
    return tostring(name), tostring(source)
end

local getUps =
    (debug and type(debug.getupvalues) == "function" and debug.getupvalues)
    or (type(getupvalues) == "function" and getupvalues)
    or nil

local function equippedTool()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Tool") or nil
end

local function isGunTool(tool)
    if not tool then return false end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return false end
    if handle:FindFirstChild("Gunshot") then return true end
    if tool:FindFirstChild("showBeam") and tool:FindFirstChild("fire") then return true end
    return false
end

local function hasNativeBeamSignature(fn, tool)
    if type(fn) ~= "function" or not tool then return false end

    local name, source = fnInfo(fn)
    if name == "ShootLocalBeam" then
        return true
    end

    if not getUps then return false end
    local ok, ups = pcall(getUps, fn)
    if not ok or type(ups) ~= "table" then return false end

    local hasFire, hasShowBeam = false, false
    for _, v in pairs(ups) do
        if typeof(v) == "Instance" and v:IsA("RemoteEvent") then
            if v.Name == "fire" and v:IsDescendantOf(tool) then
                hasFire = true
            elseif v.Name == "showBeam" and v:IsDescendantOf(tool) then
                hasShowBeam = true
            end
        end
    end

    return hasFire and hasShowBeam
end

local function findNativeBeam(tool)
    if not tool or type(getgc) ~= "function" then
        return nil, "getgc no disponible"
    end

    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then
        ok, objects = pcall(getgc)
    end
    if not ok or type(objects) ~= "table" then
        return nil, "getgc falló"
    end

    local fallback
    for _, obj in ipairs(objects) do
        if type(obj) == "function" then
            local name, source = fnInfo(obj)

            if name == "ShootLocalBeam" then
                if source ~= "" and string.find(string.lower(source), string.lower(tool.Name), 1, true) then
                    return obj
                end
                fallback = fallback or obj
            end

            if hasNativeBeamSignature(obj, tool) then
                return obj
            end
        end
    end

    return fallback, fallback and nil or "ShootLocalBeam no encontrada"
end

local function sameTeam(p)
    if not p or p == LP then return true end
    if LP.Team ~= nil and p.Team ~= nil then
        return LP.Team == p.Team
    end
    return false
end

local function getTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return nil, nil end

    local vp = camera.ViewportSize
    local cx, cy = vp.X * 0.5, vp.Y * 0.5
    local bestPlayer, bestPart, bestScore = nil, nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not sameTeam(p) then
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local part = ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart"))
            if hum and hum.Health > 0 and part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    local dx, dy = pos.X - cx, pos.Y - cy
                    local score = dx*dx + dy*dy
                    if score < bestScore then
                        bestScore = score
                        bestPlayer = p
                        bestPart = part
                    end
                end
            end
        end
    end

    return bestPlayer, bestPart
end

