local function fullRescan()
    local tool = equippedTool()
    RT.Tool = tool
    RT.BeamFunction = nil
    RT.ShootFunction = nil
    RT.Strategy = "ninguna"
    RT.Detail = ""

    if tool and isGunTool(tool) then
        local beam, shoot, strategy, detail = discover(tool)
        RT.BeamFunction = beam
        RT.ShootFunction = shoot
        RT.Strategy = strategy
        RT.Detail = detail
    end
end

