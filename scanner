local function splitLines(text)
    local lines = {}
    text = tostring(text or ""):gsub("\r\n", "\n")
    for line in (text .. "\n"):gmatch("(.-)\n") do
        lines[#lines+1] = line
    end
    return lines
end

local function addKeywordWindows(source, label)
    local lines = splitLines(source)
    local hits = {}
    local seen = {}

    for i, line in ipairs(lines) do
        for _, kw in ipairs(KEYWORDS) do
            if string.find(line, kw, 1, true) then
                local key = math.max(1, i - 6) .. ":" .. math.min(#lines, i + 12)
                if not seen[key] then
                    seen[key] = true
                    hits[#hits+1] = {
                        a = math.max(1, i - 6),
                        b = math.min(#lines, i + 12),
                        kw = kw,
                    }
                end
                break
            end
        end
    end

    add("")
    add("===== SOURCE WINDOWS: " .. label .. " =====")
    if #hits == 0 then
        add("No keyword windows found.")
        return
    end

    local shown = 0
    for _, hit in ipairs(hits) do
        shown += 1
        if shown > 30 then
            add("... more windows omitted ...")
            break
        end

        add(string.format("--- hit %s | lines %d-%d ---", hit.kw, hit.a, hit.b))
        for i = hit.a, hit.b do
            add(string.format("%04d | %s", i, lines[i] or ""))
        end
    end
end

local function scanScriptObject(obj)
    add("")
    add("SCRIPT: " .. safeFullName(obj) .. " [" .. obj.ClassName .. "]")

    if type(decompile) ~= "function" then
        add("decompile(): unavailable")
        return
    end

    local ok, source = pcall(decompile, obj)
    if not ok or type(source) ~= "string" or source == "" then
        add("decompile failed: " .. tostring(source))
        return
    end

    add("source length: " .. tostring(#source))
    addKeywordWindows(source, safeFullName(obj))
end

local function scanTool()
    table.clear(RT.Report)

    local tool = equippedTool()
    RT.Tool = tool

    add("XERO BIMO GUN SCANNER v1")
    add("Creator: Kev")
    add("PlaceId: " .. tostring(game.PlaceId))
    add("JobId: " .. tostring(game.JobId))
    add("Player: " .. tostring(LP.Name))
    add("")

    if not tool then
        add("ERROR: No equipped Tool.")
        return false
    end

    add("TOOL: " .. tool.Name)
    add("FULL: " .. safeFullName(tool))
    add("CLASS: " .. tool.ClassName)
    add("")

    add("===== IMPORTANT DESCENDANTS =====")
    local importantCount = 0
    for _, obj in ipairs(tool:GetDescendants()) do
        if interestingClasses[obj.ClassName] then
            importantCount += 1
            local extra = ""

            if obj:IsA("Sound") then
                extra = " SoundId=" .. tostring(obj.SoundId)
            elseif obj:IsA("ValueBase") then
                local ok, val = pcall(function() return obj.Value end)
                if ok then extra = " Value=" .. valueSummary(val) end
            end

            add(string.format(
                "%03d | %-18s | %s%s",
                importantCount,
                obj.ClassName,
                safeFullName(obj),
                extra
            ))
        end
    end
    add("Important descendants count: " .. tostring(importantCount))

    add("")
    add("===== DIRECT CHILDREN =====")
    for _, obj in ipairs(tool:GetChildren()) do
        add(obj.ClassName .. " | " .. obj.Name .. " | " .. safeFullName(obj))
    end

    add("")
    add("===== ATTRIBUTES =====")
    local okAttrs, attrs = pcall(function() return tool:GetAttributes() end)
    if okAttrs and type(attrs) == "table" then
        local any = false
        for k, v in pairs(attrs) do
            any = true
            add(tostring(k) .. " = " .. valueSummary(v))
        end
        if not any then add("<none>") end
    else
        add("<failed>")
    end

    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            scanScriptObject(obj)
        end
    end

    add("")
    add("===== LIVE CAPTURE =====")
    add("Press CAPTURAR DISPARO and fire ONE normal shot.")

    return true
end

local function isRelevantSelf(self)
    local tool = RT.Tool
    if not tool or not self or typeof(self) ~= "Instance" then return false end

    if self == tool or self:IsDescendantOf(tool) then
        return true
    end

    -- Algunos juegos guardan los remotes fuera de la Tool.
    -- Durante captura registramos también remotes generales.
    if self:IsA("RemoteEvent") or self:IsA("RemoteFunction") then
        return true
    end

    return false
end

local function installNamecallCapture()
    if RT.HookInstalled then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        add("LIVE HOOK ERROR: hookmetamethod/getnamecallmethod unavailable")
        return false
    end

    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if RT.Alive and RT.Capturing and os.clock() <= RT.CaptureEndsAt then
            if (method == "FireServer" or method == "InvokeServer")
                and isRelevantSelf(self) then

                add(string.format(
                    "[%.3f] %s | %s | %s",
                    os.clock(),
                    method,
                    safeFullName(self),
                    dumpArgs(...)
                ))
            elseif self == workspace
                and (method == "Raycast"
                    or method == "FindPartOnRay"
                    or method == "FindPartOnRayWithIgnoreList"
                    or method == "FindPartOnRayWithWhitelist") then

                add(string.format(
                    "[%.3f] WORLD.%s | %s",
                    os.clock(),
                    method,
                    dumpArgs(...)
                ))
            end
        end

        return old(self, ...)
    end)

    RT.OldNamecall = old
    RT.HookInstalled = true
    return true
end

local function startCapture()
    if not RT.Tool or RT.Tool.Parent == nil then
        scanTool()
    end

    if not RT.Tool then return end

    installNamecallCapture()

    add("")
    add("===== CAPTURE START " .. tostring(os.clock()) .. " =====")
    add("Tool: " .. safeFullName(RT.Tool))
    add("Haz UN disparo normal ahora.")

    RT.Capturing = true
    RT.CaptureEndsAt = os.clock() + 8

    task.delay(8.1, function()
        if not RT.Alive then return end
        if RT.Capturing then
            RT.Capturing = false
            add("===== CAPTURE END " .. tostring(os.clock()) .. " =====")
        end
    end)
end

local function reportText()
