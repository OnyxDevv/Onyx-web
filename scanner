state.Cleanup = function(restoreHooks)
    state.Active = false
    disconnectSessionConnections()
    flushDisk()

    for i = #state.Connections, 1, -1 do
        pcall(function() state.Connections[i]:Disconnect() end)
        state.Connections[i] = nil
    end

    if restoreHooks and state.DirectHooks and state.DirectHooks.InstanceNew and type(state.Raw.hookfunction) == "function" then
        pcall(state.Raw.hookfunction, Instance.new, state.DirectHooks.InstanceNew)
    end

    restoreGlobalWrappers()

    if restoreHooks and type(state.Raw.hookmetamethod) == "function" then
        if state.OldNamecall then
            pcall(state.Raw.hookmetamethod, game, "__namecall", state.OldNamecall)
        end
        if state.OldNewindex then
            pcall(state.Raw.hookmetamethod, game, "__newindex", state.OldNewindex)
        end
    end

    if state.UiRoot and state.UiRoot.Parent then
        pcall(function() state.UiRoot:Destroy() end)
    end

    if ENV.__XERO_KILLALL_ACTION_SCANNER == state then
        ENV.__XERO_KILLALL_ACTION_SCANNER = nil
    end
end

