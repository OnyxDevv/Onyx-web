local function refreshItems()
    local query = string.lower(Runtime.Search or "")
    local category = Runtime.CurrentCategory

    for key, refs in pairs(Runtime.Buttons) do
        local asset = ASSETS[key]
        local categoryMatch = asset.Category == category
        local searchMatch = true

        if query ~= "" then
            local haystack = string.lower(
                asset.Name
                .. " "
                .. tostring(asset.Id)
                .. " "
                .. asset.Category
                .. " "
                .. (asset.Badge or "")
            )

            searchMatch =
                string.find(haystack, query, 1, true) ~= nil
        end

        refs.Button.Visible = categoryMatch and searchMatch
    end

    ItemList.CanvasPosition = Vector2.new(0, 0)
end

