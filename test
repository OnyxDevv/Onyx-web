local function adjustAccessoryOffset(component, delta)
    local key = Runtime.EditorSelectedKey

    if not key
        or not Runtime.Enabled[key]
        or not ASSETS[key]
        or ASSETS[key].Kind ~= "Accessory"
    then
        setStatus("Equipa y selecciona un accesorio.", false)
        return
    end

    local state = getAccessoryOffset(key)

    if component == "X" then
        state.Position += Vector3.new(delta, 0, 0)
    elseif component == "Y" then
        state.Position += Vector3.new(0, delta, 0)
    elseif component == "Z" then
        state.Position += Vector3.new(0, 0, delta)
    elseif component == "RX" then
        state.Rotation += Vector3.new(delta, 0, 0)
    elseif component == "RY" then
        state.Rotation += Vector3.new(0, delta, 0)
    elseif component == "RZ" then
        state.Rotation += Vector3.new(0, 0, delta)
    end

    local ok, info = applyAccessoryOffset(key)

    refreshEditorValues()

    if not ok then
        setStatus("No pude mover el accesorio • " .. tostring(info), false)
    end
end

