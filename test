local function refreshItems()
    local query = string.lower(Runtime.Search or "")
    local category = Runtime.CurrentCategory

    for key, refs in pairs(Runtime.Buttons) do
        local asset = ASSETS[key]
        local categoryMatch = asset.Category == category
        local searchMatch = true

        if query ~= "" then
            local haystack = string.lower(
                asset.Name
                .. " "
                .. tostring(asset.Id)
                .. " "
                .. asset.Category
                .. " "
                .. (asset.Badge or "")
            )

            searchMatch =
                string.find(haystack, query, 1, true) ~= nil
        end

        refs.Button.Visible = categoryMatch and searchMatch
    end

    ItemList.CanvasPosition = Vector2.new(0, 0)
end

local function selectCategory(category)
    Runtime.CurrentCategory = category

    for name, button in pairs(CategoryButtons) do
        button.BackgroundColor3 =
            name == category
            and Color3.fromRGB(43, 44, 50)
            or Color3.fromRGB(20, 20, 24)

        button.TextColor3 =
            name == category
            and Color3.fromRGB(242, 243, 246)
            or Color3.fromRGB(132, 135, 143)
    end

    refreshItems()
end

