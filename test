function Runtime.Cleanup()
    cleanupVisuals()

    for i = #Runtime.Connections, 1, -1 do
        local c = Runtime.Connections[i]
        pcall(function()
            c:Disconnect()
        end)
        Runtime.Connections[i] = nil
    end

    safeDestroy(Runtime.Gui)
    Runtime.Gui = nil
end

Close.MouseButton1Click:Connect(function()
    Runtime.Cleanup()
end)

