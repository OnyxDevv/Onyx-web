local function setHeadless(enabled)
    local character = getCharacter()
    if not character then return false, "sin personaje" end

    clearCreated("Headless")
    restoreRemembered("Headless")

    if not enabled then
        return true, "restaurado"
    end

    local head = character:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then
        return false, "Head no encontrado"
    end

    -- LTM es local por definición. Conserva attachments para que sombreros
    -- y accesorios sigan anclados correctamente.
    setRemembered(
        "Headless",
        head,
        "LocalTransparencyModifier",
        1
    )

    for _, d in ipairs(head:GetDescendants()) do
        if d:IsA("Decal") or d:IsA("Texture") then
            setRemembered("Headless", d, "Transparency", 1)
        end
    end

    return true, "Headless visual local"
end

--==================================================
-- KORBLOX - DIRECT LOCAL BODY REPLACEMENT
--==================================================

local KORBLOX_MESH = {
    -- RenderMesh oficial señalado en Roblox DevForum.
    RightUpperLeg = "https://assetdelivery.roblox.com/v1/asset/?id=9598310133",

    -- IDs clásicos usados por el body package R15.
    RightLowerLeg = "rbxassetid://902942093",
    RightFoot = "rbxassetid://902942089",

    Texture = "rbxassetid://902843398",
}

local function setKorbloxR15Direct(character)
    local upper = character:FindFirstChild("RightUpperLeg")
    local lower = character:FindFirstChild("RightLowerLeg")
    local foot = character:FindFirstChild("RightFoot")

    if not upper or not upper:IsA("MeshPart") then
        return false, "RightUpperLeg no es MeshPart"
    end

    -- Guardamos el body real para poder restaurarlo exactamente.
    setRemembered("Korblox", upper, "MeshId", KORBLOX_MESH.RightUpperLeg)
    setRemembered("Korblox", upper, "TextureID", KORBLOX_MESH.Texture)
    setRemembered("Korblox", upper, "LocalTransparencyModifier", 0)

    -- El Korblox clásico visible es esencialmente la pieza superior.
    -- Ocultamos LOCALMENTE lower/foot pero NO los destruimos, porque contienen
    -- joints necesarios para animaciones, caminar y no romper el Humanoid.
    if lower and lower:IsA("MeshPart") then
        setRemembered(
            "Korblox",
            lower,
            "MeshId",
            KORBLOX_MESH.RightLowerLeg
        )
        setRemembered(
            "Korblox",
            lower,
            "LocalTransparencyModifier",
            1
        )
    end

    if foot and foot:IsA("MeshPart") then
        setRemembered(
            "Korblox",
            foot,
            "MeshId",
            KORBLOX_MESH.RightFoot
        )
        setRemembered(
            "Korblox",
            foot,
            "LocalTransparencyModifier",
            1
        )
    end

    -- Algunos juegos restauran la malla durante el mismo frame de spawn.
    -- Repetimos una vez después de dos frames sin crear ningún loop.
    task.defer(function()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()

        if not Runtime.Enabled.Korblox then
            return
        end

        local currentCharacter = LocalPlayer.Character
        if currentCharacter ~= character then
            return
        end

        pcall(function()
            upper.MeshId = KORBLOX_MESH.RightUpperLeg
            upper.TextureID = KORBLOX_MESH.Texture
            upper.LocalTransparencyModifier = 0

            if lower and lower.Parent then
                lower.MeshId = KORBLOX_MESH.RightLowerLeg
                lower.LocalTransparencyModifier = 1
            end

            if foot and foot.Parent then
                foot.MeshId = KORBLOX_MESH.RightFoot
                foot.LocalTransparencyModifier = 1
            end
        end)
    end)

    return true, "R15 direct mesh replacement"
end

local function setKorbloxR6Direct(character)
    local rightLeg =
        character:FindFirstChild("Right Leg")
        or character:FindFirstChild("RightLeg")

    if not rightLeg or not rightLeg:IsA("BasePart") then
        return false, "Right Leg R6 no encontrada"
    end

    -- Oculta visualmente la pierna rectangular original sólo en este cliente.
    setRemembered(
        "Korblox",
        rightLeg,
        "LocalTransparencyModifier",
        1
    )

    -- El CharacterMesh del Korblox Deathspeaker es la forma nativa del R6.
    local mesh = Instance.new("CharacterMesh")
    mesh.Name = "iLunX_Korblox_Deathspeaker_RightLeg"
    mesh.BodyPart = Enum.BodyPart.RightLeg
    mesh.MeshId = 101851696
    mesh.OverlayTextureId = 115727863
    mesh.Parent = character
    trackCreated("Korblox", mesh)

    return true, "R6 CharacterMesh replacement"
end

local function setKorblox(enabled)
    local character, humanoid = getCharacter()

    if not character or not humanoid then
        return false, "sin personaje"
    end

    -- IMPORTANTE:
    -- Ya no usamos ApplyDescription aquí. En la versión anterior un pcall
    -- podía devolver success aunque el servidor/juego no reflejara el cambio,
    -- y eso impedía ejecutar el fallback que sí necesitábamos.
    clearCreated("Korblox")
    restoreRemembered("Korblox")

    if not enabled then
        return true, "pierna original restaurada"
    end

    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        return setKorbloxR15Direct(character)
    end

    return setKorbloxR6Direct(character)
end

--==================================================
-- APPLY / REMOVE
--==================================================

local function applyKey(key, enabled)
    local asset = ASSETS[key]
    if not asset then return false, "asset desconocido" end

    if not enabled then
        if asset.Kind == "Headless" then
            return setHeadless(false)
        elseif asset.Kind == "Korblox" then
            return setKorblox(false)
        else
            clearCreated(key)
            restoreRemembered(key)
            return true, "removido"
        end
    end

    if asset.Kind == "Headless" then
        return setHeadless(true)
    elseif asset.Kind == "Korblox" then
        return setKorblox(true)
    else
        return addAccessoryLocal(key)
    end
end

local function restoreAll()
    for key in pairs(ASSETS) do
        Runtime.Enabled[key] = false
        clearCreated(key)
        restoreRemembered(key)
    end
end

local function reapplyEnabled()
    local enabled = {}

    for key, state in pairs(Runtime.Enabled) do
        if state then table.insert(enabled, key) end
    end

    for _, key in ipairs(enabled) do
        clearCreated(key)
        restoreRemembered(key)
    end

    for _, key in ipairs(enabled) do
        local ok, info = applyKey(key, true)
        addLog("Reapply", ASSETS[key].Name, ok, info)
    end
end

