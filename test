local function trackConnection(c)
    if c then
        table.insert(Runtime.Connections, c)
    end
    return c
end

local function trackCreated(obj)
    if obj then
        table.insert(Runtime.Created, obj)
    end
    return obj
end

local function safeDestroy(obj)
    if obj then
        pcall(function()
            obj:Destroy()
        end)
    end
end

local function getCharacter()
    Character = LocalPlayer.Character
    if not Character then
        return nil, nil
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    return Character, Humanoid
end

local function restoreHiddenParts()
    for part, oldValue in pairs(Runtime.HiddenParts) do
        if part and part.Parent then
            pcall(function()
                part.LocalTransparencyModifier = oldValue
            end)
        end
        Runtime.HiddenParts[part] = nil
    end
end

local function clearCreated(filterPrefix)
    for i = #Runtime.Created, 1, -1 do
        local obj = Runtime.Created[i]
        if not obj or not obj.Parent then
            table.remove(Runtime.Created, i)
        elseif not filterPrefix or string.sub(obj.Name, 1, #filterPrefix) == filterPrefix then
            safeDestroy(obj)
            table.remove(Runtime.Created, i)
        end
    end
end

local function cleanupVisuals()
    clearCreated()
    restoreHiddenParts()
end

--==================================================
-- DIAGNOSTICS
--==================================================

local StatusLabel
local LogLabel

local function stringify(...)
    local values = table.pack(...)
    local out = {}

    for i = 1, values.n do
        out[i] = tostring(values[i])
    end

    return table.concat(out, " ")
end

local function addLog(...)
    local text = stringify(...)
    local stamp = os.date("%H:%M:%S")
    local line = "[" .. stamp .. "] " .. text

    table.insert(Runtime.Logs, line)
    while #Runtime.Logs > 9 do
        table.remove(Runtime.Logs, 1)
    end

    print("[iLunX Appearance]", text)

    if LogLabel and LogLabel.Parent then
        LogLabel.Text = table.concat(Runtime.Logs, "\n")
    end
end

local function setStatus(text, success)
    addLog(text)

    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = text
        StatusLabel.TextColor3 = success == false
            and Color3.fromRGB(255, 126, 126)
            or Color3.fromRGB(202, 206, 213)
    end
end

--==================================================
-- ASSET LOADER
--==================================================

local function flattenLoadedObjects(rootObjects)
    local list = {}

    local function add(obj)
        if not obj then return end
        table.insert(list, obj)

        for _, d in ipairs(obj:GetDescendants()) do
            table.insert(list, d)
        end
    end

    for _, obj in ipairs(rootObjects) do
        add(obj)
    end

    return list
end

local function describeLoadedAsset(assetId, objects, method)
    local all = flattenLoadedObjects(objects)
    local types = {}
    local names = {}

    for _, obj in ipairs(all) do
        types[obj.ClassName] = (types[obj.ClassName] or 0) + 1

        if obj:IsA("Accessory")
            or obj:IsA("MeshPart")
            or obj:IsA("CharacterMesh")
            or obj:IsA("Model")
        then
            if #names < 12 then
                table.insert(names, obj.ClassName .. ":" .. obj.Name)
            end
        end
    end

    local summary = {}
    for className, count in pairs(types) do
        if className == "Accessory"
            or className == "MeshPart"
            or className == "CharacterMesh"
            or className == "SpecialMesh"
            or className == "Model"
        then
            table.insert(summary, className .. "=" .. count)
        end
    end

    table.sort(summary)

    addLog(
        "Asset",
        assetId,
        "via",
        method,
        "|",
        table.concat(summary, ", ")
    )

    if #names > 0 then
        addLog("Objetos:", table.concat(names, " | "))
    end
end

local function tryInsertService(assetId)
    local ok, result = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)

    if ok and result then
        return true, {result}, "InsertService"
    end

    addLog("InsertService fallo:", result)
    return false
end

local function tryGetObjects(assetId)
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)

    if ok and type(result) == "table" and #result > 0 then
        return true, result, "GetObjects"
    end

    addLog("GetObjects fallo:", result or "tabla vacia")
    return false
end

local function loadAssetLocal(assetId)
    -- Primero InsertService: avatar accessories pueden ser OpenUse,
    -- pero en muchos clientes externos el permiso sigue bloqueado.
    local ok, objects, method = tryInsertService(assetId)

    if not ok then
        ok, objects, method = tryGetObjects(assetId)
    end

    if not ok then
        return nil, nil
    end

    describeLoadedAsset(assetId, objects, method)
    return objects, method
end

local function destroyLoadedRoots(objects)
    if not objects then return end

    for _, obj in ipairs(objects) do
        safeDestroy(obj)
    end
end

--==================================================
-- ACCESSORY LOCAL ATTACHMENT
--==================================================

local function findAccessory(objects)
    for _, root in ipairs(objects or {}) do
        if root:IsA("Accessory") then
            return root
        end

        local accessory = root:FindFirstChildWhichIsA("Accessory", true)
        if accessory then
            return accessory
        end
    end

    return nil
end

local function findCharacterAttachment(character, attachmentName)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Attachment") and obj.Name == attachmentName then
            return obj
        end
    end

    return nil
end

local function manuallyAttachAccessory(character, accessory)
    local handle = accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        return false, "Accessory sin Handle"
    end

    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true

    -- Elimina welds viejos que puedan apuntar al rig original del asset.
    for _, d in ipairs(handle:GetChildren()) do
        if d:IsA("Weld")
            or d:IsA("WeldConstraint")
            or d:IsA("Motor6D")
        then
            safeDestroy(d)
        end
    end

    local handleAttachment = handle:FindFirstChildWhichIsA("Attachment")

    if handleAttachment then
        local bodyAttachment = findCharacterAttachment(character, handleAttachment.Name)

        if bodyAttachment and bodyAttachment.Parent:IsA("BasePart") then
            handle.CFrame =
                bodyAttachment.Parent.CFrame
                * bodyAttachment.CFrame
                * handleAttachment.CFrame:Inverse()

            local weld = Instance.new("Weld")
            weld.Name = "iLunXAccessoryWeld"
            weld.Part0 = handle
            weld.Part1 = bodyAttachment.Parent
            weld.C0 = handleAttachment.CFrame
            weld.C1 = bodyAttachment.CFrame
            weld.Parent = handle

            return true, "Attachment:" .. handleAttachment.Name
        end
    end

    -- Fallback clásico para hats/accesorios antiguos.
    local head = character:FindFirstChild("Head")

    if head and head:IsA("BasePart") then
        handle.CFrame = head.CFrame * accessory.AttachmentPoint:Inverse()

        local weld = Instance.new("Weld")
        weld.Name = "iLunXAccessoryWeld"
        weld.Part0 = handle
        weld.Part1 = head
        weld.C0 = accessory.AttachmentPoint
        weld.C1 = CFrame.new()
        weld.Parent = handle

        return true, "Head/AttachmentPoint"
    end

    return false, "No encontre attachment compatible"
end

local function addAccessoryLocal(assetKey)
    local asset = ASSETS[assetKey]
    local character, humanoid = getCharacter()

    if not character or not humanoid then
        return false, "No hay personaje"
    end

    local prefix = "iLunX_AP_" .. assetKey .. "_"
    clearCreated(prefix)

    local objects, method = loadAssetLocal(asset.Id)

    if not objects then
        return false, "No pude cargar el asset " .. asset.Id
    end

    local sourceAccessory = findAccessory(objects)

    if not sourceAccessory then
        destroyLoadedRoots(objects)
        return false, "El asset cargo, pero no contiene Accessory"
    end

    local accessory = sourceAccessory:Clone()
    accessory.Name = prefix .. sourceAccessory.Name

    -- Primero probamos la API normal. Si no crea weld, lo hacemos nosotros.
    accessory.Parent = character
    local addOk, addErr = pcall(function()
        humanoid:AddAccessory(accessory)
    end)

    local handle = accessory:FindFirstChild("Handle")
    local welded = false

    if handle then
        for _, d in ipairs(handle:GetChildren()) do
            if d:IsA("Weld") or d:IsA("WeldConstraint") then
                welded = true
                break
            end
        end
    end

    local attachInfo = "Humanoid:AddAccessory"

    if not addOk or not welded then
        local manualOk, manualInfo = manuallyAttachAccessory(character, accessory)
        if not manualOk then
            safeDestroy(accessory)
            destroyLoadedRoots(objects)

            return false,
                "AddAccessory="
                .. tostring(addErr)
                .. " | Manual="
                .. tostring(manualInfo)
        end

        attachInfo = "Manual " .. manualInfo
    end

    trackCreated(accessory)
    destroyLoadedRoots(objects)

    return true, method .. " + " .. attachInfo
end

