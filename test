local function setHeadless(enabled)
    local character = getCharacter()
    if not character then return false, "sin personaje" end

    clearCreated("Headless")
    restoreRemembered("Headless")

    if not enabled then
        return true, "restaurado"
    end

    local head = character:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then
        return false, "Head no encontrado"
    end

    -- LTM es local por definición. Conserva attachments para que sombreros
    -- y accesorios sigan anclados correctamente.
    setRemembered(
        "Headless",
        head,
        "LocalTransparencyModifier",
        1
    )

    for _, d in ipairs(head:GetDescendants()) do
        if d:IsA("Decal") or d:IsA("Texture") then
            setRemembered("Headless", d, "Transparency", 1)
        end
    end

    return true, "Headless visual local"
end

