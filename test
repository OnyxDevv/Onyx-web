local function tryInsertService(assetId)
    local ok, result = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)

    if ok and result then
        return {result}, "InsertService"
    end

    addLog("InsertService", assetId, "->", result)
    return nil
end

local function tryGetObjects(assetId)
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)

    if ok and type(result) == "table" and #result > 0 then
        return result, "GetObjects"
    end

    addLog("GetObjects", assetId, "->", result or "vacio")
    return nil
end

local function loadAssetLocal(assetId)
    local objects, method = tryInsertService(assetId)
    if objects then return objects, method end

    objects, method = tryGetObjects(assetId)
    if objects then return objects, method end

    return nil, nil
end

local function destroyRoots(objects)
    if not objects then return end
    for _, root in ipairs(objects) do safeDestroy(root) end
end

local function findAccoutrement(objects)
    for _, root in ipairs(objects or {}) do
        if root:IsA("Accoutrement") then
            return root
        end

        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Accoutrement") then
                return d
            end
        end
    end

    return nil
end

local function findCharacterAttachment(character, attachmentName)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Attachment")
            and d.Name == attachmentName
            and d.Parent:IsA("BasePart")
        then
            return d
        end
    end

    return nil
end

local function removeOldHandleJoints(handle)
    for _, d in ipairs(handle:GetChildren()) do
        if d:IsA("Weld")
            or d:IsA("WeldConstraint")
            or d:IsA("Motor6D")
        then
            safeDestroy(d)
        end
    end
end

local function manuallyAttach(character, accoutrement)
    local handle = accoutrement:FindFirstChild("Handle")

    if not handle or not handle:IsA("BasePart") then
        return false, "sin Handle"
    end

    handle.Anchored = false
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true

    removeOldHandleJoints(handle)

    local handleAttachment = handle:FindFirstChildWhichIsA("Attachment")

    if handleAttachment then
        local bodyAttachment =
            findCharacterAttachment(character, handleAttachment.Name)

        if bodyAttachment then
            handle.CFrame =
                bodyAttachment.Parent.CFrame
                * bodyAttachment.CFrame
                * handleAttachment.CFrame:Inverse()

            local weld = Instance.new("Weld")
            weld.Name = "iLunX_LocalAccessoryWeld"
            weld.Part0 = handle
            weld.Part1 = bodyAttachment.Parent
            weld.C0 = handleAttachment.CFrame
            weld.C1 = bodyAttachment.CFrame
            weld.Parent = handle

            return true, "Attachment:" .. handleAttachment.Name
        end
    end

    local head = character:FindFirstChild("Head")

    if head and head:IsA("BasePart") then
        local attachmentPoint = CFrame.new()

        pcall(function()
            attachmentPoint = accoutrement.AttachmentPoint
        end)

        handle.CFrame = head.CFrame * attachmentPoint:Inverse()

        local weld = Instance.new("Weld")
        weld.Name = "iLunX_LocalAccessoryWeld"
        weld.Part0 = handle
        weld.Part1 = head
        weld.C0 = attachmentPoint
        weld.C1 = CFrame.new()
        weld.Parent = handle

        return true, "Head fallback"
    end

    return false, "sin attachment compatible"
end

local function addAccessoryLocal(key)
    local asset = ASSETS[key]
    local character, humanoid = getCharacter()

    if not character or not humanoid then
        return false, "personaje no disponible"
    end

    clearCreated(key)

    local objects, method = loadAssetLocal(asset.Id)
    if not objects then
        return false, "loader bloqueado"
    end

    local source = findAccoutrement(objects)

    if not source then
        destroyRoots(objects)
        return false, "asset sin Accoutrement"
    end

    local clone = source:Clone()
    clone.Name = "iLunX_Vault_" .. key .. "_" .. source.Name
    clone.Parent = character

    local attached = false
    local attachInfo = ""

    if clone:IsA("Accessory") then
        local ok = pcall(function()
            humanoid:AddAccessory(clone)
        end)

        if ok then
            local handle = clone:FindFirstChild("Handle")
            if handle then
                for _, d in ipairs(handle:GetChildren()) do
                    if d:IsA("Weld")
                        or d:IsA("WeldConstraint")
                        or d:IsA("Motor6D")
                    then
                        attached = true
                        break
                    end
                end
            end
        end

        if attached then
            attachInfo = "AddAccessory"
        end
    end

    if not attached then
        local ok, info = manuallyAttach(character, clone)
        attached = ok
        attachInfo = info
    end

    if not attached then
        safeDestroy(clone)
        destroyRoots(objects)
        return false, attachInfo
    end

    trackCreated(key, clone)
    destroyRoots(objects)

    return true, method .. " + " .. attachInfo
end

