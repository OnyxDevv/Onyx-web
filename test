trackConnection(LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    Humanoid = newCharacter:WaitForChild("Humanoid")
    Runtime.OriginalDescription = nil

    task.wait(1)

    if not Runtime.Gui or not Runtime.Gui.Parent then
        return
    end

    addLog("Respawn detectado. Reaplicando seleccion...")

    task.spawn(function()
        reapplyEnabled()
    end)
end))

