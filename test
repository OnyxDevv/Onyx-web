        autoBuyBoxEnabled = Value
        if Value then
            showBottomMessage("Auto-compra iniciada...")
            task.spawn(function()
                while runtime.Alive and autoBuyBoxEnabled do
                    procesarCompra()
                    task.wait(1.5) -- Pausa obligatoria para evitar kick
                end
            end)
        else
            showBottomMessage("Auto-compra detenida.")
        end
    end
})

