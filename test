local function applyKey(key, enabled)
    local asset = ASSETS[key]
    if not asset then return false, "asset desconocido" end

    if not enabled then
        if asset.Kind == "Headless" then
            return setHeadless(false)
        elseif asset.Kind == "Korblox" then
            return setKorblox(false)
        else
            clearCreated(key)
            restoreRemembered(key)
            return true, "removido"
        end
    end

    if asset.Kind == "Headless" then
        return setHeadless(true)
    elseif asset.Kind == "Korblox" then
        return setKorblox(true)
    else
        return addAccessoryLocal(key)
    end
end

local function restoreAll()
    for key in pairs(ASSETS) do
        Runtime.Enabled[key] = false
        clearCreated(key)
        restoreRemembered(key)
    end
end

local function reapplyEnabled()
    local enabled = {}

    for key, state in pairs(Runtime.Enabled) do
        if state then table.insert(enabled, key) end
    end

    for _, key in ipairs(enabled) do
        clearCreated(key)
        restoreRemembered(key)
    end

    for _, key in ipairs(enabled) do
        local ok, info = applyKey(key, true)
        addLog("Reapply", ASSETS[key].Name, ok, info)
    end
end

