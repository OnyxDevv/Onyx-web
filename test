local function makeToggle(key)
    local asset = ASSETS[key]

    local button = Instance.new("TextButton")
    button.Name = key
    button.Size = UDim2.new(1, 0, 0, 50)
    button.BackgroundColor3 = Color3.fromRGB(29, 29, 34)
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = Content
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 13)

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, -86, 0, 21)
    name.Position = UDim2.fromOffset(14, 7)
    name.BackgroundTransparency = 1
    name.Text = asset.Name
    name.TextColor3 = Color3.fromRGB(238, 238, 242)
    name.Font = Enum.Font.GothamMedium
    name.TextSize = 13
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = button

    local id = Instance.new("TextLabel")
    id.Size = UDim2.new(1, -86, 0, 16)
    id.Position = UDim2.fromOffset(14, 27)
    id.BackgroundTransparency = 1
    id.Text = "Asset " .. tostring(asset.Id)
    id.TextColor3 = Color3.fromRGB(119, 121, 129)
    id.Font = Enum.Font.Gotham
    id.TextSize = 10
    id.TextXAlignment = Enum.TextXAlignment.Left
    id.Parent = button

    local pill = Instance.new("Frame")
    pill.Size = UDim2.fromOffset(50, 28)
    pill.Position = UDim2.new(1, -62, 0.5, -14)
    pill.BackgroundColor3 = Color3.fromRGB(52, 52, 58)
    pill.Parent = button
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(22, 22)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = Color3.fromRGB(203, 205, 211)
    knob.Parent = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    Runtime.Buttons[key] = {
        Button = button,
        Pill = pill,
        Knob = knob,
    }

    local busy = false

    local function render(state)
        TweenService:Create(
            pill,
            TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {
                BackgroundColor3 = state
                    and Color3.fromRGB(94, 97, 105)
                    or Color3.fromRGB(52, 52, 58),
            }
        ):Play()

        TweenService:Create(
            knob,
            TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {
                Position = state
                    and UDim2.fromOffset(25, 3)
                    or UDim2.fromOffset(3, 3),
                BackgroundColor3 = state
                    and Color3.fromRGB(255, 255, 255)
                    or Color3.fromRGB(203, 205, 211),
            }
        ):Play()
    end

    button.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true

        local wanted = not Runtime.Enabled[key]

        task.spawn(function()
            local ok, info

            if key == "Korblox" then
                ok, info = setKorblox(wanted)
            else
                ok, info = setAccessory(key, wanted)
            end

            if ok then
                Runtime.Enabled[key] = wanted
                render(wanted)
                setStatus(
                    asset.Name
                    .. (wanted and " activado • " or " desactivado • ")
                    .. tostring(info),
                    true
                )
            else
                Runtime.Enabled[key] = false
                render(false)
                setStatus(asset.Name .. " fallo • " .. tostring(info), false)
            end

            busy = false
        end)
    end)

    render(false)
end

