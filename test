local KORBLOX_R15_PARTS = {
    "RightUpperLeg",
    "RightLowerLeg",
    "RightFoot",
}

local function stripRigJoints(part)
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("Motor6D")
            or d:IsA("Weld")
            or d:IsA("WeldConstraint")
            or d:IsA("Script")
            or d:IsA("LocalScript")
        then
            safeDestroy(d)
        end
    end
end

local function overlayBodyPart(key, source, target)
    if not source or not target
        or not source:IsA("BasePart")
        or not target:IsA("BasePart")
    then
        return false
    end

    local visual = source:Clone()
    visual.Name = "iLunX_KorbloxVisual_" .. target.Name

    stripRigJoints(visual)

    visual.Anchored = false
    visual.CanCollide = false
    visual.CanTouch = false
    visual.CanQuery = false
    visual.Massless = true

    -- Usa la escala actual del avatar para que no quede flotando.
    pcall(function()
        visual.Size = target.Size
    end)

    visual.CFrame = target.CFrame
    visual.Parent = target.Parent

    local weld = Instance.new("WeldConstraint")
    weld.Name = "iLunX_KorbloxWeld"
    weld.Part0 = target
    weld.Part1 = visual
    weld.Parent = visual

    setRemembered(
        key,
        target,
        "LocalTransparencyModifier",
        1
    )

    trackCreated(key, visual)
    return true
end

local function tryKorbloxViaDummy(character, humanoid)
    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        return false, "dummy solo R15"
    end

    local okDesc, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)

    if not okDesc or not description then
        description = Instance.new("HumanoidDescription")
    end

    description.RightLeg = ASSETS.Korblox.Id

    local okModel, model = pcall(function()
        if Players.CreateHumanoidModelFromDescriptionAsync then
            return Players:CreateHumanoidModelFromDescriptionAsync(
                description,
                Enum.HumanoidRigType.R15,
                Enum.AssetTypeVerification.Default
            )
        else
            return Players:CreateHumanoidModelFromDescription(
                description,
                Enum.HumanoidRigType.R15,
                Enum.AssetTypeVerification.Default
            )
        end
    end)

    safeDestroy(description)

    if not okModel or not model then
        return false, "CreateHumanoidModel: " .. tostring(model)
    end

    local applied = 0

    for _, partName in ipairs(KORBLOX_R15_PARTS) do
        local source = model:FindFirstChild(partName)
        local target = character:FindFirstChild(partName)

        if source and target and overlayBodyPart("Korblox", source, target) then
            applied += 1
        end
    end

    safeDestroy(model)

    if applied > 0 then
        return true, "dummy R15 (" .. applied .. "/3)"
    end

    return false, "dummy sin piezas utiles"
end

local function findBodyObjects(objects)
    local meshParts = {}
    local characterMeshes = {}
    local named = {}

    for _, root in ipairs(objects or {}) do
        local scan = {root}
        for _, d in ipairs(root:GetDescendants()) do
            table.insert(scan, d)
        end

        for _, obj in ipairs(scan) do
            if obj:IsA("MeshPart") then
                table.insert(meshParts, obj)
                named[obj.Name] = obj
            elseif obj:IsA("CharacterMesh") then
                table.insert(characterMeshes, obj)
            end
        end
    end

    return meshParts, characterMeshes, named
end

local function tryKorbloxViaAsset(character, humanoid)
    local objects, method = loadAssetLocal(ASSETS.Korblox.Id)
    if not objects then
        return false, "body asset no cargo"
    end

    local meshParts, characterMeshes, named = findBodyObjects(objects)
    local applied = 0

    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        for _, partName in ipairs(KORBLOX_R15_PARTS) do
            local source = named[partName]
            local target = character:FindFirstChild(partName)

            if source and target
                and overlayBodyPart("Korblox", source, target)
            then
                applied += 1
            end
        end

        if applied == 0 and #meshParts > 0 then
            -- Último fallback: algunos body assets devuelven una sola MeshPart.
            local target =
                character:FindFirstChild("RightLowerLeg")
                or character:FindFirstChild("RightUpperLeg")

            if target
                and overlayBodyPart(
                    "Korblox",
                    meshParts[1],
                    target
                )
            then
                applied = 1

                local foot = character:FindFirstChild("RightFoot")
                if foot then
                    setRemembered(
                        "Korblox",
                        foot,
                        "LocalTransparencyModifier",
                        1
                    )
                end
            end
        end
    else
        -- R6: CharacterMesh sí es la representación nativa.
        for _, cm in ipairs(characterMeshes) do
            local isRightLeg = false

            pcall(function()
                isRightLeg =
                    cm.BodyPart == Enum.BodyPart.RightLeg
            end)

            if isRightLeg then
                local clone = cm:Clone()
                clone.Name = "iLunX_Korblox_R6"
                clone.Parent = character
                trackCreated("Korblox", clone)
                applied += 1
            end
        end

        -- Fallback R6 conocido del Deathspeaker si el asset body no expone
        -- CharacterMesh utilizable.
        if applied == 0 then
            local cm = Instance.new("CharacterMesh")
            cm.Name = "iLunX_Korblox_R6_Fallback"
            cm.BodyPart = Enum.BodyPart.RightLeg
            cm.MeshId = 101851696
            cm.OverlayTextureId = 101851254
            cm.Parent = character
            trackCreated("Korblox", cm)
            applied = 1
        end
    end

    destroyRoots(objects)

    if applied > 0 then
        return true, method .. " body fallback (" .. applied .. ")"
    end

    return false, "asset body sin visual util"
end

local function setKorblox(enabled)
    local character, humanoid = getCharacter()
    if not character or not humanoid then
        return false, "sin personaje"
    end

    clearCreated("Korblox")
    restoreRemembered("Korblox")

    if not enabled then
        return true, "restaurado"
    end

    -- 1) Probamos ApplyDescription por si el entorno sí permite AvatarAppearance.
    local okDesc, errDesc = pcall(function()
        local description = humanoid:GetAppliedDescription()
        description.RightLeg = ASSETS.Korblox.Id

        if humanoid.ApplyDescriptionAsync then
            humanoid:ApplyDescriptionAsync(description)
        else
            humanoid:ApplyDescription(description)
        end

        safeDestroy(description)
    end)

    if okDesc then
        return true, "HumanoidDescription"
    end

    addLog("Korblox ApplyDescription bloqueado:", errDesc)

    -- 2) Nuevo: construir un rig LOCAL temporal con la pierna oficial,
    -- extraer sus MeshParts y soldarlas sobre nuestro rig.
    local okDummy, infoDummy =
        tryKorbloxViaDummy(character, humanoid)

    if okDummy then
        return true, infoDummy
    end

    addLog("Korblox dummy fallo:", infoDummy)

    -- 3) Fallback directo al contenido del body asset.
    local okAsset, infoAsset =
        tryKorbloxViaAsset(character, humanoid)

    if okAsset then
        return true, infoAsset
    end

    return false,
        "dummy=" .. tostring(infoDummy)
        .. " | asset=" .. tostring(infoAsset)
end

