local EditorValues = {}

local function formatVectorValue(value, degrees)
    if degrees then
        return string.format("%.0f°", value)
    end
    return string.format("%.2f", value)
end

local function refreshEditorValues()
    local key = Runtime.EditorSelectedKey
    local asset = key and ASSETS[key] or nil

    if not key or not asset or not Runtime.Enabled[key] then
        EditorSelectedLabel.Text = "Equipa un accesorio primero"

        for _, label in pairs(EditorValues) do
            label.Text = "--"
        end
        return
    end

    EditorSelectedLabel.Text = asset.Name

    local state = getAccessoryOffset(key)

    EditorValues.X.Text =
        formatVectorValue(state.Position.X, false)
    EditorValues.Y.Text =
        formatVectorValue(state.Position.Y, false)
    EditorValues.Z.Text =
        formatVectorValue(state.Position.Z, false)

    EditorValues.RX.Text =
        formatVectorValue(state.Rotation.X, true)
    EditorValues.RY.Text =
        formatVectorValue(state.Rotation.Y, true)
    EditorValues.RZ.Text =
        formatVectorValue(state.Rotation.Z, true)
end

local function chooseEditorAccessory(direction)
    local equipped = getEquippedAccessoryKeys()

    if #equipped == 0 then
        Runtime.EditorSelectedKey = nil
        refreshEditorValues()
        return
    end

    local currentIndex = 1

    for i, key in ipairs(equipped) do
        if key == Runtime.EditorSelectedKey then
            currentIndex = i
            break
        end
    end

    if direction then
        currentIndex =
            ((currentIndex - 1 + direction) % #equipped) + 1
    elseif not table.find(equipped, Runtime.EditorSelectedKey) then
        currentIndex = 1
    end

    Runtime.EditorSelectedKey = equipped[currentIndex]
    refreshEditorValues()
end

PrevAccessory.MouseButton1Click:Connect(function()
    chooseEditorAccessory(-1)
end)

NextAccessory.MouseButton1Click:Connect(function()
    chooseEditorAccessory(1)
end)

