local function trackConnection(c)
    if c then table.insert(Runtime.Connections, c) end
    return c
end

local function safeDestroy(obj)
    if obj then
        pcall(function() obj:Destroy() end)
    end
end

local function getCharacter()
    Character = LocalPlayer.Character
    Humanoid = Character and Character:FindFirstChildOfClass("Humanoid") or nil
    return Character, Humanoid
end

local function trackCreated(key, obj)
    if not obj then return obj end
    Runtime.CreatedByKey[key] = Runtime.CreatedByKey[key] or {}
    table.insert(Runtime.CreatedByKey[key], obj)
    return obj
end

local function clearCreated(key)
    local list = Runtime.CreatedByKey[key]
    if not list then return end

    for i = #list, 1, -1 do
        safeDestroy(list[i])
        list[i] = nil
    end

    Runtime.CreatedByKey[key] = nil
end

local function rememberProperty(key, obj, property)
    Runtime.HiddenByKey[key] = Runtime.HiddenByKey[key] or {}
    local map = Runtime.HiddenByKey[key]
    map[obj] = map[obj] or {}

    if map[obj][property] == nil then
        local ok, value = pcall(function() return obj[property] end)
        if ok then
            map[obj][property] = value
        end
    end
end

local function setRemembered(key, obj, property, value)
    if not obj then return end
    rememberProperty(key, obj, property)
    pcall(function() obj[property] = value end)
end

local function restoreRemembered(key)
    local map = Runtime.HiddenByKey[key]
    if not map then return end

    for obj, props in pairs(map) do
        if obj and obj.Parent then
            for property, value in pairs(props) do
                pcall(function() obj[property] = value end)
            end
        end
    end

    Runtime.HiddenByKey[key] = nil
end

