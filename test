-- HUMANOID DESCRIPTION ROUTE
--==================================================

local function appendAccessoryId(current, id)
    current = tostring(current or "")

    for n in string.gmatch(current, "%d+") do
        if tonumber(n) == id then
            return current
        end
    end

    if current == "" then
        return tostring(id)
    end

    return current .. "," .. tostring(id)
end

local function removeAccessoryId(current, id)
    local result = {}

    for n in string.gmatch(tostring(current or ""), "%d+") do
        if tonumber(n) ~= id then
            table.insert(result, n)
        end
    end

    return table.concat(result, ",")
end

local function tryApplyDescription(mutator)
    local character, humanoid = getCharacter()

    if not character or not humanoid then
        return false, "No hay Humanoid"
    end

    local okDescription, description = pcall(function()
        return humanoid:GetAppliedDescription()
    end)

    if not okDescription or not description then
        return false, "GetAppliedDescription: " .. tostring(description)
    end

    if not Runtime.OriginalDescription then
        Runtime.OriginalDescription = description:Clone()
    end

    local okMutate, mutateErr = pcall(mutator, description)
    if not okMutate then
        safeDestroy(description)
        return false, "Mutator: " .. tostring(mutateErr)
    end

    local applyOk, applyErr = pcall(function()
        if humanoid.ApplyDescriptionAsync then
            humanoid:ApplyDescriptionAsync(description)
        else
            humanoid:ApplyDescription(description)
        end
    end)

    safeDestroy(description)

    if not applyOk then
        return false, tostring(applyErr)
    end

    return true, "HumanoidDescription"
end

local function applyAccessoryDescription(assetKey, enabled)
    local asset = ASSETS[assetKey]

    return tryApplyDescription(function(description)
        -- Crown y horns son accesorios de cabeza.
        if enabled then
            description.HatAccessory =
                appendAccessoryId(description.HatAccessory, asset.Id)
        else
            description.HatAccessory =
                removeAccessoryId(description.HatAccessory, asset.Id)
        end
    end)
end

local function applyKorbloxDescription(enabled)
    return tryApplyDescription(function(description)
        if enabled then
            description.RightLeg = ASSETS.Korblox.Id
        elseif Runtime.OriginalDescription then
            description.RightLeg = Runtime.OriginalDescription.RightLeg
        end
    end)
end

--==================================================
-- KORBLOX VISUAL FALLBACK
--==================================================

local R15_RIGHT_PARTS = {
    RightUpperLeg = true,
    RightLowerLeg = true,
    RightFoot = true,
}

local function collectCandidateBodyParts(objects)
    local exact = {}
    local meshParts = {}
    local characterMeshes = {}

    for _, root in ipairs(objects or {}) do
        local scan = {root}

        for _, d in ipairs(root:GetDescendants()) do
            table.insert(scan, d)
        end

        for _, obj in ipairs(scan) do
            if obj:IsA("MeshPart") then
                table.insert(meshParts, obj)

                if R15_RIGHT_PARTS[obj.Name] then
                    exact[obj.Name] = obj
                end
            elseif obj:IsA("CharacterMesh") then
                table.insert(characterMeshes, obj)
            end
        end
    end

    return exact, meshParts, characterMeshes
end

local function hideLocalPart(part)
    if not Runtime.HiddenParts[part] then
        Runtime.HiddenParts[part] = part.LocalTransparencyModifier
    end

    part.LocalTransparencyModifier = 1
end

local function cloneVisualMesh(source, target, name)
    if not source:IsA("BasePart") or not target:IsA("BasePart") then
        return nil
    end

    local visual = source:Clone()
    visual.Name = "iLunX_Korblox_" .. name

    -- Quitar scripts/joints del asset cargado.
    for _, d in ipairs(visual:GetDescendants()) do
        if d:IsA("Script")
            or d:IsA("LocalScript")
            or d:IsA("Motor6D")
            or d:IsA("Weld")
            or d:IsA("WeldConstraint")
        then
            safeDestroy(d)
        end
    end

    visual.Anchored = false
    visual.CanCollide = false
    visual.CanTouch = false
    visual.CanQuery = false
    visual.Massless = true

    -- Conservamos la escala del limb actual para que el visual siga el rig.
    pcall(function()
        visual.Size = target.Size
    end)

    visual.CFrame = target.CFrame
    visual.Parent = target.Parent

    local weld = Instance.new("WeldConstraint")
    weld.Name = "iLunX_KorbloxWeld"
    weld.Part0 = target
    weld.Part1 = visual
    weld.Parent = visual

    hideLocalPart(target)
    trackCreated(visual)

    return visual
end

local function applyKorbloxVisualFallback()
    local character, humanoid = getCharacter()

    if not character or not humanoid then
        return false, "No hay personaje"
    end

    clearCreated("iLunX_Korblox_")
    restoreHiddenParts()

    local objects, method = loadAssetLocal(ASSETS.Korblox.Id)

    if not objects then
        return false, "No pude cargar Korblox"
    end

    local exact, meshParts, characterMeshes =
        collectCandidateBodyParts(objects)

    addLog(
        "Korblox encontrados:",
        "exact=" .. tostring(
            (exact.RightUpperLeg and 1 or 0)
            + (exact.RightLowerLeg and 1 or 0)
            + (exact.RightFoot and 1 or 0)
        ),
        "meshParts=" .. tostring(#meshParts),
        "characterMeshes=" .. tostring(#characterMeshes)
    )

    local applied = 0

    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        -- Mejor caso: el asset trae nombres R15 exactos.
        for partName in pairs(R15_RIGHT_PARTS) do
            local source = exact[partName]
            local target = character:FindFirstChild(partName)

            if source and target and target:IsA("BasePart") then
                if cloneVisualMesh(source, target, partName) then
                    applied += 1
                end
            end
        end

        -- Algunos body-part assets solo exponen un MeshPart.
        -- Lo aplicamos sobre RightLowerLeg como fallback visual.
        if applied == 0 and #meshParts > 0 then
            local target =
                character:FindFirstChild("RightLowerLeg")
                or character:FindFirstChild("RightUpperLeg")

            if target then
                if cloneVisualMesh(meshParts[1], target, "Fallback") then
                    applied = 1

                    local foot = character:FindFirstChild("RightFoot")
                    if foot and foot:IsA("BasePart") then
                        hideLocalPart(foot)
                    end
                end
            end
        end
    else
        -- R6 puede traer CharacterMesh. Lo clonamos localmente.
        for _, characterMesh in ipairs(characterMeshes) do
            local clone = characterMesh:Clone()
            clone.Name = "iLunX_Korblox_R6_" .. characterMesh.Name
            clone.Parent = character
            trackCreated(clone)
            applied += 1
        end
    end

    destroyLoadedRoots(objects)

    if applied <= 0 then
        return false,
            "Asset cargo pero no encontre una pieza corporal util. Mira Diagnostico."
    end

    return true, method .. " visual fallback (" .. applied .. " pieza/s)"
end

--==================================================
-- APPLY / REMOVE
--==================================================

local function removeLocalAccessory(assetKey)
    local prefix = "iLunX_AP_" .. assetKey .. "_"
    clearCreated(prefix)
end

local function setAccessory(assetKey, enabled)
    Runtime.Enabled[assetKey] = enabled

    if not enabled then
        removeLocalAccessory(assetKey)

        -- Si HumanoidDescription local funciona, intenta limpiarlo tambien.
        task.spawn(function()
            local ok = applyAccessoryDescription(assetKey, false)
            if ok then
                addLog(ASSETS[assetKey].Name, "removido de HumanoidDescription")
            end
        end)

        return true, "Desactivado"
    end

    setStatus("Probando " .. ASSETS[assetKey].Name .. "...")

    -- Ruta 1: description.
    local descOk, descInfo = applyAccessoryDescription(assetKey, true)

    if descOk then
        -- Verificar si realmente apareció un accessory que corresponda.
        task.wait(0.15)
        addLog(ASSETS[assetKey].Name, "Description OK:", descInfo)

        -- Aunque Description diga OK, añadimos fallback si no hay resultado visible
        -- identificable. Así también funciona en clientes que aceptan la llamada
        -- pero luego el servidor resetea la apariencia.
    else
        addLog(
            ASSETS[assetKey].Name,
            "Description bloqueado:",
            descInfo
        )
    end

    local localOk, localInfo = addAccessoryLocal(assetKey)

    if localOk then
        return true, "Local OK: " .. localInfo
    end

    if descOk then
        return true, "Description OK; fallback fallo: " .. tostring(localInfo)
    end

    return false,
        "Description: "
        .. tostring(descInfo)
        .. " | Loader: "
        .. tostring(localInfo)
end

local function setKorblox(enabled)
    Runtime.Enabled.Korblox = enabled

    if not enabled then
        clearCreated("iLunX_Korblox_")
        restoreHiddenParts()

        local ok, info = applyKorbloxDescription(false)
        if ok then
            return true, "Korblox restaurado"
        end

        return true, "Fallback visual restaurado | " .. tostring(info)
    end

    setStatus("Probando Korblox...")

    local descOk, descInfo = applyKorbloxDescription(true)

    if descOk then
        addLog("Korblox Description OK:", descInfo)
        return true, "HumanoidDescription OK"
    end

    addLog("Korblox Description bloqueado:", descInfo)

    local visualOk, visualInfo = applyKorbloxVisualFallback()

    if visualOk then
        return true, visualInfo
    end

    return false,
        "Description: "
        .. tostring(descInfo)
        .. " | Visual: "
        .. tostring(visualInfo)
end

local function restoreAll()
    for key in pairs(Runtime.Enabled) do
        Runtime.Enabled[key] = false
    end

    cleanupVisuals()

    local character, humanoid = getCharacter()

    if humanoid and Runtime.OriginalDescription then
        local ok, err = pcall(function()
            if humanoid.ApplyDescriptionAsync then
                humanoid:ApplyDescriptionAsync(
                    Runtime.OriginalDescription:Clone()
                )
            else
                humanoid:ApplyDescription(
                    Runtime.OriginalDescription:Clone()
                )
            end
        end)

        addLog(
            "Restore original HumanoidDescription:",
            ok,
            err or ""
        )
    end
end

local function reapplyEnabled()
    cleanupVisuals()

    for key, enabled in pairs(Runtime.Enabled) do
        if enabled then
            if key == "Korblox" then
                local ok, info = setKorblox(true)
                addLog("Reapply Korblox:", ok, info)
            else
                local ok, info = setAccessory(key, true)
                addLog("Reapply", key .. ":", ok, info)
            end
        end
    end
end

