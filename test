local StatusLabel
local LogLabel

local function stringify(...)
    local args = table.pack(...)
    local out = {}
    for i = 1, args.n do out[i] = tostring(args[i]) end
    return table.concat(out, " ")
end

local function addLog(...)
    local line = "[" .. os.date("%H:%M:%S") .. "] " .. stringify(...)
    table.insert(Runtime.Logs, line)

    while #Runtime.Logs > 7 do
        table.remove(Runtime.Logs, 1)
    end

    print("[iLunX Appearance Vault]", stringify(...))

    if LogLabel and LogLabel.Parent then
        LogLabel.Text = table.concat(Runtime.Logs, "\n")
    end
end

local function setStatus(text, success)
    addLog(text)

    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = text
        StatusLabel.TextColor3 =
            success == false
            and Color3.fromRGB(255, 126, 126)
            or Color3.fromRGB(201, 204, 211)
    end
end

