-- ==========================================
-- 🚀 DETECCIÓN REAL DE EQUIPOS DE DUELS
-- DUELS deja Player.Team=nil / TeamColor=White / Neutral=true incluso en 4v4.
-- La señal fiable observada en partida es HumanoidRootPart.TeammateIconPart:
-- el juego la crea únicamente sobre compañeros visibles para el LocalPlayer.
-- ==========================================

local TEAMMATE_MARKER_NAME = "TeammateIconPart"
local enemyCache = {}

-- ==========================================================
-- MEMORIA DE EQUIPO POR RONDA
-- DUELS elimina TeammateIconPart cuando un compañero muere/desaparece.
-- Nunca usamos la presencia ACTUAL del marker como memoria de la ronda:
-- una vez observado, ese UserId sigue siendo aliado hasta la siguiente ronda.
-- ==========================================================
local teamRoundState = {
    InRound = false,
    Generation = 0,
    MarkerSystemSeen = false,
    KnownTeammates = {}, -- [UserId] = true durante toda la ronda
    PendingExitAt = nil,
    EnteredAt = 0,
    LastCombatTrueAt = 0,
    SoloFallbackReadyAt = 0,
    TeammateLeftThisRound = false,
}
runtime.TeamRoundState = teamRoundState

local function clearTeamRoundMemory(inRound)
    local entering = inRound == true
    local now = os.clock()

    teamRoundState.Generation += 1
    teamRoundState.InRound = entering
    teamRoundState.MarkerSystemSeen = false
    teamRoundState.PendingExitAt = nil
    teamRoundState.TeammateLeftThisRound = false
    table.clear(teamRoundState.KnownTeammates)
    enemyCache = {}

    if entering then
        teamRoundState.EnteredAt = now
        teamRoundState.LastCombatTrueAt = now
        -- Da tiempo a que DUELS cree TeammateIconPart. Si no aparece ningún marker,
        -- después de esta ventana asumimos modo solo y permitimos 1vN por misma arena.
        teamRoundState.SoloFallbackReadyAt = now + 1.15
    else
        teamRoundState.EnteredAt = 0
        teamRoundState.LastCombatTrueAt = 0
        teamRoundState.SoloFallbackReadyAt = 0
    end

    -- R48: teammate identities and their corpse cache share the same round lifetime.
    if runtime.ClearTeamCorpseCache then
        runtime.ClearTeamCorpseCache()
    end
end

local function syncTeamRoundState(inRoundOverride)
    local inRound = inRoundOverride
    if inRound == nil then
        inRound = false
        if runtime.IsCombatRound then
            local ok, result = pcall(runtime.IsCombatRound)
            inRound = ok and result == true
        end
    else
        inRound = inRound == true
    end

    local now = os.clock()

    if inRound then
        teamRoundState.PendingExitAt = nil
        teamRoundState.LastCombatTrueAt = now
        if not teamRoundState.InRound then
            clearTeamRoundMemory(true)
        end
        return true
    end

    if not teamRoundState.InRound then
        return false
    end

    -- FIX 1vN: un ForceField/transición de un solo instante ya no puede borrar
    -- KnownTeammates/MarkerSystemSeen en plena ronda. Lobby/votación por posición o
    -- Team de espectador sí son evidencia fuerte y limpian inmediatamente.
    local hardLobby = isTeamLobby == true
    if not hardLobby then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position
            for i = 1, #ZONAS_SEGURAS do
                local zona = ZONAS_SEGURAS[i]
                local delta = pos - zona.Centro
                if delta:Dot(delta) <= zona.RadioSq then
                    hardLobby = true
                    break
                end
            end
        end
    end

    if hardLobby then
        clearTeamRoundMemory(false)
        return false
    end

    -- Si IsCombatRound parpadea false fuera de las zonas seguras, conservar la
    -- ronda durante una ventana corta. El resto de features sigue usando enLobby,
    -- así que esto no habilita ESP/aim dentro del lobby real.
    if not teamRoundState.PendingExitAt then
        teamRoundState.PendingExitAt = now
        return true
    end

    if now - teamRoundState.PendingExitAt >= 1.0 then
        clearTeamRoundMemory(false)
        return false
    end

    return true
end
