function isEnemy(targetPlayer)
    if not teamCheckEnabled then
        return targetPlayer ~= player
    end
    if not targetPlayer or targetPlayer == player then
        return false
    end

    syncTeamRoundState()

    -- Relación persistente: un aliado sigue siendo aliado aunque haya muerto y
    -- TeammateIconPart ya no exista en su Character actual.
    if isRememberedTeammate(targetPlayer) then
        return false
    end

    local cached = enemyCache[targetPlayer]
    if cached ~= nil then
        return cached
    end

    local char = targetPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not char or not hum or hum.Health <= 0 or not hrp then
        return false
    end

    -- Señal nativa de compañero. Guardarla ANTES de cualquier otra inferencia.
    if hrp:FindFirstChild(TEAMMATE_MARKER_NAME) then
        rememberTeammate(targetPlayer)
        return false
    end

    -- En cuanto el sistema de markers se observó UNA VEZ en esta ronda,
    -- su desaparición posterior ya no desactiva la clasificación.
    if teammateMarkerSystemActive() then
        enemyCache[targetPlayer] = true
        return true
    end

    local result = fallbackEnemyRelation(targetPlayer)
    if result == true then
        enemyCache[targetPlayer] = true
    end
    return result
end

