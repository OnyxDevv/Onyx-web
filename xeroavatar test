local function getServerPlayers()
    local values = {}
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            values[#values + 1] = target.Name
        end
    end
    table.sort(values, function(a, b) return string.lower(a) < string.lower(b) end)
    if #values == 0 then values[1] = "Sin jugadores" end
    return values
end

local initialPlayers = getServerPlayers()
runtime.Appearance.AvatarClone.SelectedServerPlayer =
    initialPlayers[1] ~= "Sin jugadores" and initialPlayers[1] or nil

local playerDropdown = Tab:Dropdown({
    Title = "Jugador del servidor",
    Values = initialPlayers,
    Value = initialPlayers[1],
    Callback = function(value)
        runtime.Appearance.AvatarClone.SelectedServerPlayer =
            value ~= "Sin jugadores" and value or nil
    end,
})

local function refreshServerPlayers()
    if not runtime.Alive or not playerDropdown then return end
    local values = getServerPlayers()
    local selected = runtime.Appearance.AvatarClone.SelectedServerPlayer
    local found = false
    for _, name in ipairs(values) do
        if name == selected then found = true break end
    end
    if not found then
        runtime.Appearance.AvatarClone.SelectedServerPlayer =
            values[1] ~= "Sin jugadores" and values[1] or nil
    end
    pcall(function() playerDropdown:Refresh(values) end)
end

runtime.Track(Players.PlayerAdded:Connect(function() task.defer(refreshServerPlayers) end))
