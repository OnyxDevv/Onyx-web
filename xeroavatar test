function runtime.OpenUserOutfits(forceRefresh)
    local userId, username, resolveError = runtime.ResolveOutfitBrowserUser()
    if not userId then
        showBottomMessage(resolveError)
        return false
    end

    local state = runtime.EnsureOutfitBrowser()
    state.CurrentUserId = userId
    state.CurrentUserName = username
    state.Title.Text = "Skins de @" .. tostring(username)
    state.Count.Text = "Cargando outfits..."
    state.SearchBox.Text = ""
    runtime.BringOutfitBrowserToFront()
    state.Overlay.Visible = true

    task.spawn(function()
        local outfits, err = runtime.FetchUserOutfits(userId, forceRefresh == true)
        if not runtime.Alive or not state.Gui or not state.Gui.Parent then return end
        if state.CurrentUserId ~= userId then return end

        if not outfits then
            state.Count.Text = "No se pudieron cargar"
            showBottomMessage(tostring(err or "No se pudieron cargar los outfits"))
            return
        end

        state.CurrentOutfits = outfits
        runtime.RenderOutfitBrowser()
        if #outfits == 0 then
            showBottomMessage("Ese usuario no tiene outfits guardados públicos.")
        end
    end)

    return true
end



function runtime.Cleanup()
    if not runtime.Alive then return end

    pcall(function()
        if runtime.DestroyOutfitBrowser then runtime.DestroyOutfitBrowser() end
    end)

    -- Restaura también Headless/Korblox/caras/limiteds y destruye sus templates/guards.
    pcall(function()
        if runtime.AppearanceCleanup then runtime.AppearanceCleanup()
        elseif runtime.AvatarCloneDestroyOverlay then runtime.AvatarCloneDestroyOverlay(true) end
    end)

    runtime.Alive = false

    local state = runtime.Appearance and runtime.Appearance.AvatarClone
    if state then
        if state.Template then
            pcall(function() state.Template:Destroy() end)
            state.Template = nil
        end
        if state.VisualContainer and state.VisualContainer.Parent then
            pcall(function() state.VisualContainer:Destroy() end)
        end
        state.VisualContainer = nil
        state.Active = false
    end

    for i = #runtime.Connections, 1, -1 do
        local connection = runtime.Connections[i]
        pcall(function() connection:Disconnect() end)
        runtime.Connections[i] = nil
    end

    if runtime.ToastGui and runtime.ToastGui.Parent then
        pcall(function() runtime.ToastGui:Destroy() end)
    end
    runtime.ToastGui = nil

    if runtimeEnv.__XERO_COPY_AVATAR_RUNTIME == runtime then
        runtimeEnv.__XERO_COPY_AVATAR_RUNTIME = nil
    end
end




