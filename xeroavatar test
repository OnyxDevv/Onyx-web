function runtime.HttpGetJson(url)
    local body
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, response = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Roblox/XeroHub-OutfitBrowser",
                    ["Accept"] = "application/json",
                },
            })
        end)
        if ok and response then
            local status = tonumber(response.StatusCode) or tonumber(response.Status)
            if not status or (status >= 200 and status < 300) then
                body = response.Body or response.body
            end
        end
    end

    if type(body) ~= "string" or body == "" then
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if ok then body = result end
    end

    if type(body) ~= "string" or body == "" then
        return nil, "No se pudo consultar Roblox"
    end

    local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(decoded) ~= "table" then
        return nil, "Roblox devolvió una respuesta inválida"
    end
    return decoded
end

function runtime.ResolveOutfitBrowserUser()
    local input = tostring(runtime.Appearance.AvatarClone.UsernameInput or "")
        :gsub("^%s+", ""):gsub("%s+$", "")

    if input ~= "" then
        local okId, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(input)
        end)
        if not okId or not userId then
            return nil, nil, "No se encontró ese username"
        end

        local resolved = input
        pcall(function() resolved = Players:GetNameFromUserIdAsync(userId) end)
        return userId, resolved
    end

    local selected = runtime.Appearance.AvatarClone.SelectedServerPlayer
    local target = selected and Players:FindFirstChild(selected) or nil
    if target and target ~= player then
        return target.UserId, target.Name
    end

    return nil, nil, "Escribe un username o selecciona un jugador del servidor"
end

function runtime.FetchUserOutfits(userId, forceRefresh)
    userId = tonumber(userId)
    if not userId then return nil, "UserId inválido" end

    if not forceRefresh and runtime.OutfitBrowser.Cache[userId] then
        return runtime.OutfitBrowser.Cache[userId]
    end

    local outfits = {}
    local seen = {}
    local page = 1

    -- El endpoint v1 sigue permitiendo paginar los outfits guardados. Usamos
    -- isEditable=true para mostrar las skins creadas/guardadas por el usuario y
    -- no llenar la lista con presets de bundles.
    while page <= 20 do
        local url = "https://avatar.roblox.com/v1/users/"
            .. tostring(userId)
            .. "/outfits?page=" .. tostring(page)
            .. "&itemsPerPage=50&isEditable=true"

        local decoded, err = runtime.HttpGetJson(url)
        if not decoded then
            if page == 1 then return nil, err end
            break
        end

        local data = type(decoded.data) == "table" and decoded.data or {}
        for _, item in ipairs(data) do
            local outfitId = tonumber(item.id)
            if outfitId and not seen[outfitId] then
                seen[outfitId] = true
                outfits[#outfits + 1] = {
                    Id = outfitId,
                    Name = tostring(item.name or ("Outfit " .. tostring(outfitId))),
                    Editable = item.isEditable ~= false,
                }
            end
        end

        if #data < 50 then break end
        page += 1
        task.wait(0.04)
    end

    runtime.OutfitBrowser.Cache[userId] = outfits
    return outfits
end

function runtime.GetHumanoidDescriptionFromOutfitIdSafe(outfitId)
    outfitId = tonumber(outfitId)
    if not outfitId then return nil, "Outfit inválido" end

    local ok, description = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
    end)
    if ok and description then return description end

    ok, description = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitId(outfitId)
    end)
    if ok and description then return description end

    return nil, tostring(description or "No se pudo cargar ese outfit")
end

function runtime.CloneAvatarFromOutfitId(outfitId, outfitName, ownerUserId, ownerName, silent)
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "Tu personaje todavía no cargó" end

    local description, err = runtime.GetHumanoidDescriptionFromOutfitIdSafe(outfitId)
    if not description then return false, err end

    local template, templateErr = runtime.CreateAvatarCloneTemplateFromDescription(description, humanoid.RigType)
    pcall(function() description:Destroy() end)
    if not template then return false, templateErr end

    local displayName = tostring(ownerName or "Usuario") .. " · " .. tostring(outfitName or "Outfit")
    return runtime.SetClonedAvatarTemplate(template, ownerUserId, displayName, silent, outfitId)
end

