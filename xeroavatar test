function runtime.BringOutfitBrowserToFront()
    local state = runtime.OutfitBrowser
    local gui = state and state.Gui
    if not gui or not gui.Parent then return end

    runtime.RestoreOutfitBrowserGuiOrder()

    local parent = gui.Parent
    local restore = setmetatable({}, {__mode = "k"})
    local ownName = string.lower(gui.Name)
    for _, other in ipairs(parent:GetChildren()) do
        if other ~= gui and other:IsA("ScreenGui") then
            local name = string.lower(other.Name or "")
            local likelyHub = string.find(name, "xero", 1, true)
                or string.find(name, "ilun", 1, true)
                or string.find(name, "wind", 1, true)
                or string.find(name, "nox", 1, true)
                or string.find(name, "hub", 1, true)
            if likelyHub and other.DisplayOrder >= 2147483646 then
                restore[other] = other.DisplayOrder
                pcall(function() other.DisplayOrder = 2147483646 end)
            end
        end
    end
    state.GuiOrderRestore = restore

    -- Si el hub usa el mismo DisplayOrder máximo, reparentar al final resuelve
    -- el empate de sibling order sin esconder la ventana principal.
    pcall(function()
        gui.Parent = nil
        gui.Parent = parent
        gui.DisplayOrder = 2147483647
        gui.Enabled = true
    end)
end

